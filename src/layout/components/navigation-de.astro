---
/*do I need this?
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
*/

const base = "/TaCoS-Trier";
const path = Astro.url.pathname;

const isGerman =
  path === `${base}/de` ||
  path.startsWith(`${base}/de/`);

const englishPath = isGerman
  ? path.replace(`${base}/de`, base)
  : path;

const germanPath = isGerman
  ? path
  : `${base}/de${path.slice(base.length)}`;
---

<nav class="bg-[#ffeda8] shadow antialiased md:static sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex items-center min-h-20 pl-0 pr-4 px-4">

    <a href="/TaCoS-Trier/de/" class="shrink-0 mr-16">
      <img
        src="/TaCoS-Trier/images/logo.png"
        alt="TaCoS 2027 Logo"
        class="h-28 py-2 w-auto"
      />
    </a>
    
    <button
      id="mobile-menu-button"
      class="md:hidden ml-auto p-2 focus:outline-none"
      aria-label="Menü öffnen">
      <span id="burger-icon" class="block text-3xl leading-none">☰</span>
    </button>


    <ul class="hidden md:flex gap-2 ml-auto">
      <li><a href="/TaCoS-Trier/de/" class="nav-link">Home</a></li>
      <li><a href="/TaCoS-Trier/de/team" class="nav-link">Team</a></li>
      <li><a href="/TaCoS-Trier/de/sponsors" class="nav-link">Sponsoren</a></li>
      <li><a href="/TaCoS-Trier/de/speakers" class="nav-link">Referent*innen</a></li>
      <li><a href="/TaCoS-Trier/de/registration" class="nav-link">Teilnehmen</a></li>
      <li><a href="/TaCoS-Trier/de/schedule" class="nav-link">Programm</a></li>
      <li><a href="/TaCoS-Trier/de/map" class="nav-link">Karten</a></li>
      <li><a href="/TaCoS-Trier/de/contact" class="nav-link">Kontakt</a></li>

<li class="flex items-center gap-1 ml-2">
  <a
    href={germanPath}
    lang="de"
    aria-current={isGerman ? "page" : undefined}
    class:list={[
      "inline-flex items-center gap-1 rounded-md border px-2 py-1",
      "text-sm transition-colors duration-200",
      isGerman
        ? "bg-white/80 border-gray-400/60 text-black"
        : "border-transparent hover:border-gray-400/60 hover:bg-white/30"
    ]}
  >
    <span>🇩🇪</span>
    <span>DE</span>
  </a>

  <a
    href={englishPath}
    lang="en"
    aria-current={!isGerman ? "page" : undefined}
    class:list={[
      "inline-flex items-center gap-1 rounded-md border px-2 py-1",
      "text-sm transition-colors duration-200",
      !isGerman
        ? "bg-white/80 border-gray-400/60 text-black"
        : "border-transparent hover:border-gray-400/60 hover:bg-white/30"
    ]}
  >
    <span>🇬🇧</span>
    <span>EN</span>
  </a>
</li>

    </ul>
  </div>
</nav>

<div id="mobile-menu" class="md:hidden hidden bg-[#ffeda8] px-4 pb-6">
  <ul class="flex flex-col gap-2">
      <li><a href="/TaCoS-Trier/de/" class="nav-link">Home</a></li>
      <li><a href="/TaCoS-Trier/de/team" class="nav-link">Team</a></li>
      <li><a href="/TaCoS-Trier/de/sponsors" class="nav-link">Sponsoren</a></li>
      <li><a href="/TaCoS-Trier/de/speakers" class="nav-link">Referent*innen</a></li>
      <li><a href="/TaCoS-Trier/de/registration" class="nav-link">Teilnehmen</a></li>
      <li><a href="/TaCoS-Trier/de/schedule" class="nav-link">Programm</a></li>
      <li><a href="/TaCoS-Trier/de/map" class="nav-link">Karten</a></li>
      <li><a href="/TaCoS-Trier/de/contact" class="nav-link">Kontakt</a></li>
    </ul>
</div>

