---

<nav class="bg-[#ffeda8] shadow antialiased md:static sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex items-center min-h-20 pl-0 pr-4 px-4">

    <a href="/" class="shrink-0 mr-16">
      <img
        src="/images/l
ogo.png"
        alt="TaCoS 2027 Logo"
        class="h-28 py-2 w-auto"
      />
    </a>
    
    <button
      id="mobile-menu-button"
      class="md:hidden ml-auto p-2 focus:outline-none"
      aria-label="Menü öffnen">
      <span id="burger-icon" class="block text-3xl leading-none">☰</span>
    </button>


    <ul class="hidden md:flex gap-2 ml-auto">
      <li><a href="/" class="nav-link">Home</a></li>
      <li><a href="/team" class="nav-link">Team</a></li>
      <li><a href="/sponsors" class="nav-link">Sponsors</a></li>
      <li><a href="/speakers" class="nav-link">Speakers</a></li>
      <li><a href="/registration" class="nav-link">Registration</a></li>
      <li><a href="/schedule" class="nav-link">Schedule</a></li>
      <li><a href="/map" class="nav-link">Map</a></li>
      <li><a href="/contact" class="nav-link">Contact</a></li>
    </ul>
  </div>
</nav>

<div id="mobile-menu" class="md:hidden hidden bg-[#ffeda8] px-4 pb-6">
  <ul class="flex flex-col gap-2">
      <li><a href="/" class="nav-link">Home</a></li>
      <li><a href="/about" class="nav-link">About TaCoS</a></li>
      <li><a href="/team" class="nav-link">Team</a></li>
      <li><a href="/sponsors" class="nav-link">Sponsors</a></li>
      <li><a href="/speakers" class="nav-link">Speakers</a></li>
      <li><a href="/registration" class="nav-link">Registration</a></li>
      <li><a href="/schedule" class="nav-link">Schedule</a></li>
      <li><a href="/map" class="nav-link">Map</a></li>
      <li><a href="/contact" class="nav-link">Contact</a></li>
    </ul>
</div>

