---
const base = "/TaCoS-Trier";
---

<footer class="bg-white border-t border-slate-200/90 text-slate-600 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Brand & Description -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <img
            src={`${base}/images/logo.png`}
            alt="TaCoS 2027 Logo"
            class="h-10 w-10 object-contain rounded-lg"
          />
          <div>
            <span class="font-bold text-slate-900 text-lg block leading-tight">TaCoS Trier 2027</span>
            <span class="text-xs text-red-700 font-semibold tracking-wide uppercase">36. Tagung der Computerlinguistik-Studierenden</span>
          </div>
        </div>
        <p class="text-sm text-slate-600 max-w-md leading-relaxed">
          Die jährliche Tagung für Studierende der Computerlinguistik und benachbarter Fächer – von Studierenden für Studierende organisiert. Zu Gast an der Universität Trier vom 03. bis 05. Juni 2027.
        </p>
        <div class="flex items-center gap-4 pt-2">
          <a
            href="https://www.instagram.com/tacosconference/"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg bg-slate-100 text-slate-600 hover:text-red-700 hover:bg-red-50 transition-colors"
            aria-label="Folge uns auf Instagram"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 448 512">
              <path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z" />
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/company/tacosconference/"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg bg-slate-100 text-slate-600 hover:text-red-700 hover:bg-red-50 transition-colors"
            aria-label="Auf LinkedIn vernetzen"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 448 512">
              <path d="M100.3 448H7.4V148.9h92.9zM53.8 108.1C24.1 108.1 0 83.5 0 53.8a53.8 53.8 0 0 1 107.6 0c0 29.7-24.1 54.3-53.8 54.3zM447.9 448h-92.7V302.4c0-34.7-.7-79.2-48.3-79.2-48.3 0-55.7 37.7-55.7 76.7V448h-92.8V148.9h89.1v40.8h1.3c12.4-23.5 42.7-48.3 87.9-48.3 94 0 111.3 61.9 111.3 142.3V448z" />
            </svg>
          </a>
          <a
            href="mailto:tacos@uni-trier.de"
            class="p-2 rounded-lg bg-slate-100 text-slate-600 hover:text-red-700 hover:bg-red-50 transition-colors"
            aria-label="E-Mail an das Organisationsteam"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-900 mb-3">Tagung</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}/de/team`} class="hover:text-red-700 transition">Team</a></li>
          <li><a href={`${base}/de/speakers`} class="hover:text-red-700 transition">Referent*innen</a></li>
          <li><a href={`${base}/de/schedule`} class="hover:text-red-700 transition">Programm</a></li>
          <li><a href={`${base}/de/registration`} class="hover:text-red-700 transition">Teilnahme</a></li>
          <li><a href={`${base}/de/map`} class="hover:text-red-700 transition">Lagepläne</a></li>
        </ul>
      </div>

      <!-- University & Contact -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-900 mb-3">Gastgebende Universität</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="https://www.uni-trier.de/" target="_blank" rel="noopener noreferrer" class="hover:text-red-700 transition font-medium">
              Universität Trier &rarr;
            </a>
          </li>
          <li>
            <a href="https://linguistik.computer/" target="_blank" rel="noopener noreferrer" class="hover:text-red-700 transition">
              Frühere TaCoS-Ausgaben &rarr;
            </a>
          </li>
          <li>
            <a href={`${base}/de/sponsors`} class="hover:text-red-700 transition">
              Sponsoring-Informationen
            </a>
          </li>
          <li>
            <a href="mailto:tacos@uni-trier.de" class="text-red-700 hover:text-red-800 font-medium">
              tacos@uni-trier.de
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="mt-8 pt-6 border-t border-slate-200/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; {new Date().getFullYear()} TaCoS Trier 2027. Alle Rechte vorbehalten.</p>
      <p>Organisiert von Studierenden der Universität Trier.</p>
    </div>
  </div>
</footer>
