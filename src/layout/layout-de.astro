---
import '../styles/global.css'

import Navigation from "./components/navigation-de.astro";
import Footer from "./components/footer-de.astro";

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
}

const {
  title = "36. TaCoS Trier 2027 | Tagung der Computerlinguistik-Studierenden",
  description = "Die 36. Tagung der Computerlinguistik-Studierenden (TaCoS) vom 03. bis 05. Juni 2027 an der Universität Trier.",
  fullWidth = false
} = Astro.props;
---

<!doctype html>
<html lang="de" class="h-full bg-slate-50">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/TaCoS-Trier/images/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet"/>

    <title>{title}</title>
  </head>
  <body class="min-h-full flex flex-col bg-slate-50 text-slate-800 antialiased selection:bg-red-100 selection:text-red-900">
    <Navigation />
    <main class={fullWidth ? "w-full grow" : "max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 grow"}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
