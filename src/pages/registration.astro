---
import Layout from '../layout/layout.astro'

const base = "/TaCoS-Trier";

const benefits = [
  {
    title: "All Academic Sessions",
    desc: "Unrestricted access to all keynote lectures, student presentations, tutorials, and workshop tracks.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`,
  },
  {
    title: "Student Accommodation",
    desc: "Traditional TaCoS collective lodging (bring sleeping bag & mat) included for all enrolled student participants.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />`,
  },
  {
    title: "Breakfast & Coffee Breaks",
    desc: "Daily morning breakfast and coffee & tea breaks between presentation blocks.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
  },
  {
    title: "Social Events & City Tour",
    desc: "Icebreaker evening, networking dinner, and social activities exploring historic Trier.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  },
];
---

<Layout
  title="Registration & Participation | 36. TaCoS Trier 2027"
  description="Registration details, fees, and accommodation information for the 36th TaCoS Conference at Trier University."
>
  <div class="space-y-16 py-4">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 text-red-800 text-xs font-semibold tracking-wide border border-red-200">
        Attendance & Registration
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Join Us in Trier
      </h1>
      <p class="text-slate-600 text-base sm:text-lg">
        TaCoS is open to students of all universities, degree levels, and related disciplines (Computational Linguistics, Computer Science, Linguistics, AI, Digital Humanities).
      </p>
    </div>

    <!-- Status Banner -->
    <div class="max-w-3xl mx-auto bg-gradient-to-r from-red-50 via-white to-red-50 border border-red-200/80 rounded-2xl p-6 sm:p-8 text-center space-y-3 shadow-xs">
      <span class="inline-block px-3 py-1 rounded-full bg-red-700 text-white text-xs font-bold uppercase tracking-wider">
        Registration Status
      </span>
      <h2 class="text-2xl font-bold text-slate-900">Registration Opens in Early 2027</h2>
      <p class="text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
        The formal registration portal will open once the keynote speakers and workshop tracks are finalized. In true TaCoS tradition, conference fees are kept minimal to make participation accessible to every student.
      </p>
      <div class="pt-2">
        <a
          href="mailto:tacos@uni-trier.de?subject=Pre-Registration%20Inquiry%20TaCoS%202027"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-red-700 text-white font-semibold text-sm hover:bg-red-800 transition"
        >
          <span>Notify Me When Registration Opens</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
        </a>
      </div>
    </div>

    <!-- What's Included -->
    <section class="max-w-4xl mx-auto space-y-6">
      <div class="text-center">
        <h2 class="text-2xl font-bold text-slate-900">What's Included in Your Ticket?</h2>
        <p class="text-sm text-slate-500 mt-1">Everything you need for an unforgettable conference experience</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {benefits.map((item) => (
          <div class="bg-white rounded-2xl p-6 shadow-xs border border-slate-200 hover:shadow-md hover:border-red-200 transition-all flex items-start gap-4">
            <div class="h-12 w-12 rounded-xl bg-red-50 text-red-700 flex items-center justify-center shrink-0">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={item.icon} />
            </div>
            <div class="space-y-1">
              <h3 class="text-base font-bold text-slate-900">{item.title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ Snippet -->
    <section class="max-w-3xl mx-auto bg-white rounded-2xl p-8 border border-slate-200 shadow-xs space-y-6">
      <h3 class="text-xl font-bold text-slate-900 border-b border-slate-100 pb-3">Frequently Asked Questions</h3>
      
      <div class="space-y-4 text-sm text-slate-600">
        <div>
          <h4 class="font-bold text-slate-900">Do I need to give a presentation to attend?</h4>
          <p class="mt-1">No! While we encourage attendees to submit abstracts or workshop ideas, listeners and active participants are equally welcome.</p>
        </div>

        <div>
          <h4 class="font-bold text-slate-900">What do I need to bring for collective lodging?</h4>
          <p class="mt-1">If you opt for the student group lodging, you will need a sleeping pad/isomat and a sleeping bag. Showers and sanitary facilities are available on-site.</p>
        </div>

        <div>
          <h4 class="font-bold text-slate-900">Can travel costs be reimbursed?</h4>
          <p class="mt-1">Many university student councils (Fachschaften) or institutes provide travel grants for students attending scientific conferences. Check with your local department!</p>
        </div>
      </div>
    </section>

  </div>
</Layout>
