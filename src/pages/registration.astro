---
import Layout from '../layout/layout.astro';

const base = "/TaCoS-Trier";

const benefits = [
  {
    title: "All Academic Sessions",
    desc: "Access to all keynote lectures, student presentations, tutorials, and workshops.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`,
  },
  {
    title: "Breakfast and Coffee Breaks",
    desc: "Daily morning breakfast and coffee breaks between presentation blocks.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
  },
  {
    title: "Social Events and City Tour",
    desc: "Icebreaker evening, networking dinner, and social program exploring historic Trier.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  },
];
---

<Layout
  title="Registration | 36. TaCoS Trier 2027"
  description="Registration details, fees, and participation information for the 36th TaCoS at Trier University."
>
  <div class="space-y-12 py-4">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 tracking-tight">
        Registration
      </h1>
      <p class="text-slate-600 text-base sm:text-lg">
        TaCoS is open to students from all universities and related fields (Computational Linguistics, NLP, Computer Science, Linguistics, Digital Humanities, Phonetics).
      </p>
    </div>

    <!-- Status Banner: Under Development -->
    <div class="max-w-3xl mx-auto bg-amber-50/80 border border-amber-200 rounded-xl p-6 sm:p-8 text-center space-y-3">
      <div class="inline-block text-xs font-mono uppercase tracking-wider text-amber-800 font-bold">
        Status: In Preparation
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-amber-950">Registration Opens in Early 2027</h2>
      <p class="text-xs sm:text-sm text-amber-900 max-w-xl mx-auto leading-relaxed">
        Registration will open once the schedule and ticket system are finalized. In TaCoS tradition, fees are kept as low as possible to make the conference accessible to every student. Announcements will be posted on this page and on our social channels.
      </p>
      <div class="pt-3 flex flex-wrap justify-center gap-3">
        <a
          href="https://www.instagram.com/tacosconference/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white border border-amber-200 hover:bg-amber-100/50 text-slate-800 text-xs font-semibold transition"
        >
          <span>Instagram: @tacosconference</span>
        </a>
        <a
          href="https://www.linkedin.com/company/tacosconference/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white border border-amber-200 hover:bg-amber-100/50 text-slate-800 text-xs font-semibold transition"
        >
          <span>LinkedIn: tacosconference</span>
        </a>
      </div>
    </div>

    <!-- What is included -->
    <section class="max-w-4xl mx-auto space-y-6">
      <div class="text-center">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900">What is included in the fee?</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {benefits.map((item) => (
          <div class="bg-white rounded-xl p-6 border border-slate-200 flex flex-col items-start gap-3">
            <div class="h-10 w-10 rounded-lg bg-red-50 text-red-700 flex items-center justify-center shrink-0">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={item.icon} />
            </div>
            <div class="space-y-1">
              <h3 class="text-base font-bold text-slate-900">{item.title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-3xl mx-auto bg-white rounded-xl p-6 sm:p-8 border border-slate-200 space-y-5">
      <h3 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3">Frequently Asked Questions</h3>
      
      <div class="space-y-4 text-sm text-slate-600">
        <div>
          <h4 class="font-bold text-slate-900">Do I need to give a presentation to attend?</h4>
          <p class="mt-1 text-xs sm:text-sm">No. While we encourage attendees to submit abstracts or workshop proposals, listeners and participants without a presentation are equally welcome.</p>
        </div>

        <div>
          <h4 class="font-bold text-slate-900">Will accommodation recommendations be provided?</h4>
          <p class="mt-1 text-xs sm:text-sm">Yes. Information and tips on accommodation options in Trier will be shared on this website ahead of registration opening.</p>
        </div>

        <div>
          <h4 class="font-bold text-slate-900">Can travel costs be reimbursed?</h4>
          <p class="mt-1 text-xs sm:text-sm">Many university student councils (Fachschaften) or university institutes provide travel grants for students attending scientific conferences. Check with your local department.</p>
        </div>
      </div>
    </section>

  </div>
</Layout>
