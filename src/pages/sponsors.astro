---
import Layout from '../layout/layout.astro';

const base = "/TaCoS-Trier";

const sponsors = [
  {
    name: "Trier University",
    desc: "Host university and faculty",
  },
  {
    name: "FSR CoDiPho Trier",
    desc: "Fachschaft Computerlinguistik, Digital Humanities und Phonetik at Trier University",
  },
];
---

<Layout
  title="Sponsors | 36. TaCoS Trier 2027"
  description="Information about sponsors and supporting TaCoS 2027 at Trier University."
>
  <div class="space-y-12 py-6 max-w-4xl mx-auto">

    <!-- Header -->
    <div class="text-center space-y-3">
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
        Sponsors
      </h1>
      <p class="text-slate-600 text-base max-w-xl mx-auto">
        TaCoS 2027 is supported by Trier University, the student council CoDiPho, and our sponsors.
      </p>
    </div>

    <!-- Sponsor Logos and Placeholders -->
    <section class="bg-white rounded-xl border border-slate-200 p-8 sm:p-10 space-y-8">
      <div>
        <h2 class="text-xs font-mono uppercase tracking-wider text-slate-500 mb-4 text-center">
          Institutional Support
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {sponsors.map((item) => (
            <div class="p-6 rounded-lg border border-slate-200 bg-slate-50/50 text-center flex flex-col justify-center min-h-28">
              <span class="text-base font-bold text-slate-900">{item.name}</span>
              <span class="text-xs text-slate-500 mt-1">{item.desc}</span>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h2 class="text-xs font-mono uppercase tracking-wider text-slate-500 mb-4 text-center">
          Conference Sponsors and Partners
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-6 rounded-lg border-2 border-dashed border-slate-300 bg-slate-50/50 text-center flex flex-col items-center justify-center min-h-28">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-600 font-bold">Your Logo Here</span>
            <span class="text-[11px] text-slate-400 mt-1">Sponsor slot available</span>
          </div>
          <div class="p-6 rounded-lg border-2 border-dashed border-slate-300 bg-slate-50/50 text-center flex flex-col items-center justify-center min-h-28">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-600 font-bold">Your Logo Here</span>
            <span class="text-[11px] text-slate-400 mt-1">Sponsor slot available</span>
          </div>
          <div class="p-6 rounded-lg border-2 border-dashed border-slate-300 bg-slate-50/50 text-center flex flex-col items-center justify-center min-h-28">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-600 font-bold">Your Logo Here</span>
            <span class="text-[11px] text-slate-400 mt-1">Sponsor slot available</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Support Information -->
    <section class="bg-white rounded-xl border border-slate-200 p-8 sm:p-10 space-y-4">
      <h2 class="text-xl font-bold text-slate-900">
        Supporting the Conference
      </h2>
      <p class="text-slate-600 text-sm leading-relaxed">
        TaCoS is a student conference. Sponsorship helps keep registration fees low for attending students, covers catering and breakfast, and funds local organization.
      </p>
      <p class="text-slate-600 text-sm leading-relaxed">
        Beyond financial support, in-kind contributions such as books, conference kits, or workshop equipment are also welcome.
      </p>

      <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="text-sm font-semibold text-slate-900 block">Interested in supporting TaCoS 2027?</span>
          <span class="text-xs text-slate-500">Reach out to the student team on LinkedIn or Instagram while our university inbox is being set up.</span>
        </div>
        <div class="flex items-center gap-2">
          <a
            href="https://www.linkedin.com/company/tacosconference/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-red-700 text-white font-medium text-xs hover:bg-red-600 transition-colors"
          >
            LinkedIn
          </a>
          <a
            href="https://www.instagram.com/tacosconference/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-slate-100 text-slate-700 font-medium text-xs hover:bg-slate-200 transition-colors"
          >
            Instagram
          </a>
        </div>
      </div>
    </section>

  </div>
</Layout>
