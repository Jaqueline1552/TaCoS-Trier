---
import Layout from '../layout/layout.astro'

const base = "/TaCoS-Trier";

const tiers = [
  {
    tier: "Main Sponsors & Partners",
    badge: "Gold / Main",
    slots: [
      { name: "Sponsorship Slot Available", note: "Prominent logo placement, welcome bag inclusion, talk slot" },
      { name: "Sponsorship Slot Available", note: "Prominent logo placement, welcome bag inclusion, talk slot" },
    ]
  },
  {
    tier: "Supporting Sponsors",
    badge: "Silver",
    slots: [
      { name: "Sponsorship Slot Available", note: "Logo on website and printed conference brochure" },
      { name: "Sponsorship Slot Available", note: "Logo on website and printed conference brochure" },
      { name: "Sponsorship Slot Available", note: "Logo on website and printed conference brochure" },
    ]
  },
  {
    tier: "Academic & Institutional Supporters",
    badge: "Academic",
    slots: [
      { name: "Trier University", note: "Host Institution & Faculty of Language, Literature and Media" },
      { name: "Student Union / Fachschaft", note: "Co-organizing support and local logistics" },
    ]
  }
];
---

<Layout
  title="Sponsors & Partners | 36. TaCoS Trier 2027"
  description="Become a sponsor of the 36th TaCoS Conference at Trier University and support student researchers in computational linguistics."
>
  <div class="space-y-16 py-4">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 text-red-800 text-xs font-semibold tracking-wide border border-red-200">
        Partners & Funding
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Our Generous Sponsors
      </h1>
      <p class="text-slate-600 text-base sm:text-lg">
        TaCoS is made possible through the generous support of academic institutions and industry sponsors who believe in fostering the next generation of NLP talent.
      </p>
    </div>

    <!-- Sponsor Tiers -->
    <section class="space-y-12 max-w-5xl mx-auto">
      {tiers.map((section) => (
        <div class="space-y-4">
          <div class="flex items-center justify-between border-b border-slate-200 pb-3">
            <h2 class="text-xl font-bold text-slate-900">{section.tier}</h2>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">
              {section.badge}
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {section.slots.map((item) => (
              <div class="bg-white rounded-2xl p-6 shadow-xs border border-slate-200 hover:shadow-md hover:border-red-200 transition-all flex flex-col justify-between text-center min-h-44">
                <div class="flex items-center justify-center h-20 bg-slate-50 rounded-xl border border-dashed border-slate-200 mb-4">
                  <span class="text-sm font-semibold text-slate-400">{item.name}</span>
                </div>
                <p class="text-xs text-slate-500 leading-relaxed">{item.note}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- Why Sponsor Card -->
    <section class="max-w-4xl mx-auto bg-white rounded-2xl p-8 sm:p-10 shadow-sm border border-slate-200 space-y-6">
      <div class="border-b border-slate-100 pb-4">
        <h3 class="text-2xl font-bold text-slate-900">Why Support TaCoS 2027?</h3>
        <p class="text-sm text-red-700 font-semibold tracking-wide uppercase mt-1">
          Direct impact on student education & networking
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-slate-600 leading-relaxed">
        <div class="space-y-2">
          <h4 class="font-bold text-slate-900 flex items-center gap-2">
            <span class="text-red-700">✓</span> Affordable Attendance
          </h4>
          <p>
            Your sponsorship keeps registration fees low and subsidizes accommodation and breakfast for student participants traveling from across Germany, Austria, and Switzerland.
          </p>
        </div>

        <div class="space-y-2">
          <h4 class="font-bold text-slate-900 flex items-center gap-2">
            <span class="text-red-700">✓</span> Talent Recruitment
          </h4>
          <p>
            Gain direct access to highly motivated students, graduates, and future PhD researchers specializing in Computational Linguistics, NLP, Machine Learning, and Digital Humanities.
          </p>
        </div>

        <div class="space-y-2">
          <h4 class="font-bold text-slate-900 flex items-center gap-2">
            <span class="text-red-700">✓</span> Materials & Catering
          </h4>
          <p>
            Support conference programs, badges, workshop technical equipment, and social dinners that foster lasting friendships and academic collaborations.
          </p>
        </div>

        <div class="space-y-2">
          <h4 class="font-bold text-slate-900 flex items-center gap-2">
            <span class="text-red-700">✓</span> In-Kind Donations
          </h4>
          <p>
            Beyond financial contributions, we warmly welcome in-kind donations such as computing credits, books, conference kits, and giveaways for participants.
          </p>
        </div>
      </div>

      <!-- Action Box -->
      <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="block text-sm font-bold text-slate-900">Interested in becoming a sponsor?</span>
          <span class="text-xs text-slate-500">Contact us at tacos@uni-trier.de to request our partnership dossier.</span>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
          <a
            href="mailto:tacos@uni-trier.de?subject=Sponsoring%20TaCoS%202027"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl bg-red-700 text-white font-semibold text-sm hover:bg-red-800 transition"
          >
            <span>Contact Sponsorship Team</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>
    </section>

  </div>
</Layout>
