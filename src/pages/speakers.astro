---
import Layout from '../layout/layout.astro';

const base = "/TaCoS-Trier";
---

<Layout
  title="Speakers | 36. TaCoS Trier 2027"
  description="Keynote speakers and presentation tracks for the 36th TaCoS at Trier University."
>
  <div class="space-y-12 py-4 max-w-4xl mx-auto">

    <!-- Header -->
    <div class="text-center space-y-3">
      <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 tracking-tight">
        Speakers
      </h1>
      <p class="text-slate-600 text-base sm:text-lg">
        Keynote lectures and student presentations at TaCoS 2027 in Trier.
      </p>
    </div>

    <!-- Status Notice: Keynotes to be Announced -->
    <div class="bg-amber-50/80 border border-amber-200 rounded-xl p-6 sm:p-8 text-center sm:text-left flex flex-col sm:flex-row items-center sm:items-start gap-5">
      <div class="h-10 w-10 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center shrink-0 font-bold text-base">
        i
      </div>
      <div class="space-y-2">
        <h2 class="text-base font-bold text-amber-950">Keynote Speakers to be Announced</h2>
        <p class="text-xs sm:text-sm text-amber-900 leading-relaxed">
          Invitations and confirmations for invited keynote speakers from academia and industry are currently underway. Confirmed speaker profiles, lecture topics, and abstracts will be published here in early 2027.
        </p>
      </div>
    </div>

    <!-- Speaker Tracks -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white rounded-xl border border-slate-200 p-6 space-y-3">
        <span class="text-xs font-mono uppercase tracking-wider text-red-700 block">Track 01</span>
        <h2 class="text-lg font-bold text-slate-900">Keynote Lectures</h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          Invited researchers from academia and industry present foundational overviews and current research developments in computational linguistics and language technology.
        </p>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 p-6 space-y-3">
        <span class="text-xs font-mono uppercase tracking-wider text-red-700 block">Track 02</span>
        <h2 class="text-lg font-bold text-slate-900">Student Talks and Posters</h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          Presentations given by student participants at Bachelor, Master, or PhD level. Topics cover seminar projects, theses, research papers, and experimental tools.
        </p>
      </div>
    </section>

    <!-- Call for Abstracts Information -->
    <section class="bg-white rounded-xl border border-slate-200 p-8 text-center space-y-3">
      <h2 class="text-xl font-bold text-slate-900">Call for Abstracts</h2>
      <p class="text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
        The submission portal for student presentations and posters will open in early 2027. Submission guidelines and deadlines will be announced on this page and on our social channels.
      </p>
      <div class="pt-3 flex flex-wrap justify-center gap-3">
        <a
          href="https://www.instagram.com/tacosconference/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition"
        >
          <span>Instagram: @tacosconference</span>
        </a>
        <a
          href="https://www.linkedin.com/company/tacosconference/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition"
        >
          <span>LinkedIn: tacosconference</span>
        </a>
      </div>
    </section>

  </div>
</Layout>
