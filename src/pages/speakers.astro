---
import Layout from '../layout/layout.astro'

const base = "/TaCoS-Trier";

const placeholderSpeakers = [
  {
    name: "Keynote Speaker I",
    role: "Professor for Digital Humanities & NLP",
    institution: "Trier University",
    topic: "Modern Language Models & Historical Corpora",
    image: `${base}/images/PB.png`,
    status: "To be announced",
  },
  {
    name: "Keynote Speaker II",
    role: "Senior NLP Research Scientist",
    institution: "Industry / Research Lab",
    topic: "Speech Recognition & Multimodal AI",
    image: `${base}/images/PB.png`,
    status: "To be announced",
  },
  {
    name: "Keynote Speaker III",
    role: "Computational Linguist & Educator",
    institution: "Partner University",
    topic: "Low-Resource Languages & Syntax",
    image: `${base}/images/PB.png`,
    status: "To be announced",
  },
];
---

<Layout
  title="Keynote Speakers | 36. TaCoS Trier 2027"
  description="Discover the keynote speakers and guest lecturers presenting at the 36th TaCoS Conference at Trier University."
>
  <div class="space-y-16 py-4">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 text-red-800 text-xs font-semibold tracking-wide border border-red-200">
        Scientific Program
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Keynote Speakers
      </h1>
      <p class="text-slate-600 text-base sm:text-lg">
        We invite leading researchers from academia and industry to deliver inspiring keynote lectures at TaCoS 2027 in Trier.
      </p>
    </div>

    <!-- Announcement Alert -->
    <div class="max-w-2xl mx-auto bg-amber-50/70 border border-amber-200 rounded-2xl p-4 text-center">
      <p class="text-xs sm:text-sm font-medium text-amber-900">
        📢 Keynote speaker confirmations are currently underway. Full speaker announcements and lecture abstracts will be published here soon.
      </p>
    </div>

    <!-- Speakers Grid -->
    <section class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {placeholderSpeakers.map((speaker) => (
          <div class="bg-white rounded-2xl p-6 shadow-xs border border-slate-200 hover:shadow-md hover:border-red-200 transition-all flex flex-col items-center text-center">
            <div class="relative mb-5">
              <img
                src={speaker.image}
                alt={speaker.name}
                class="w-32 h-32 rounded-full object-cover ring-4 ring-slate-100 shadow-xs"
              />
              <span class="absolute bottom-1 right-1 bg-slate-800 text-white text-[10px] font-semibold px-2 py-0.5 rounded-full">
                Keynote
              </span>
            </div>
            
            <h3 class="text-lg font-bold text-slate-900">{speaker.name}</h3>
            <p class="text-xs font-semibold text-red-700 mt-0.5">{speaker.role}</p>
            <p class="text-xs text-slate-500 mt-1">{speaker.institution}</p>
            
            <div class="mt-4 pt-4 border-t border-slate-100 w-full text-left">
              <span class="text-[11px] uppercase tracking-wider font-semibold text-slate-400 block mb-1">
                Planned Topic
              </span>
              <p class="text-xs text-slate-600 italic">
                "{speaker.topic}"
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Call for Student Presentations -->
    <section class="max-w-3xl mx-auto bg-white rounded-2xl p-8 border border-slate-200 shadow-xs text-center space-y-4">
      <span class="text-xs font-bold uppercase tracking-wider text-red-700">Student Contributions</span>
      <h3 class="text-2xl font-bold text-slate-900">Present Your Own Research!</h3>
      <p class="text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
        TaCoS is by students, for students. Whether it's your bachelor's or master's thesis, a term paper, or a fun side project in NLP, we encourage all students to submit a talk or workshop proposal.
      </p>
      <div class="pt-2">
        <a
          href="mailto:tacos@uni-trier.de"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-red-700 text-white font-semibold text-sm hover:bg-red-800 transition"
        >
          <span>Submit an Abstract / Inquiry</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </section>

  </div>
</Layout>
