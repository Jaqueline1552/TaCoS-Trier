---
import Layout from '../layout/layout.astro'

const base = "/TaCoS-Trier";

const featureCards = [
  {
    href: `${base}/team`,
    title: "Organizing Team",
    desc: "Meet the dedicated student committee behind TaCoS 2027 at Trier University.",
    badge: "Student Org",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`,
  },
  {
    href: `${base}/speakers`,
    title: "Keynote Speakers",
    desc: "Distinguished academic and industry researchers sharing insights in NLP and computational linguistics.",
    badge: "Keynotes",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />`,
  },
  {
    href: `${base}/schedule`,
    title: "Program & Schedule",
    desc: "Explore talks, workshops, poster sessions, and evening networking events.",
    badge: "Timeline",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
  },
  {
    href: `${base}/registration`,
    title: "Registration & Lodging",
    desc: "Information about conference attendance, student accommodation, and breakfast fees.",
    badge: "Join Us",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />`,
  },
  {
    href: `${base}/map`,
    title: "Campus & Venue Maps",
    desc: "Floor plans and directions for lecture halls and rooms across Campus I & II.",
    badge: "Directions",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />`,
  },
  {
    href: `${base}/sponsors`,
    title: "Sponsors & Partners",
    desc: "Generous institutions and companies supporting computational linguistics education.",
    badge: "Partners",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`,
  },
  {
    href: `${base}/contact`,
    title: "Get in Touch",
    desc: "Have questions, suggestions, or want to contribute? Reach out to our organizing team.",
    badge: "Contact",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
  },
];
---

<Layout
  title="36. TaCoS Trier 2027 | Computational Linguistics Student Conference"
  description="Join us June 03–05, 2027 at Trier University for the 36th Student Conference on Computational Linguistics (TaCoS)."
>
  <div class="space-y-16">

    <!-- Hero Section -->
    <section class="text-center space-y-6 pt-4 sm:pt-8">
      
      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-50 border border-red-200/80 text-red-800 text-xs sm:text-sm font-semibold tracking-wide">
        <span class="inline-block w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
        36. Tagung der Computerlinguistik-Studierenden
      </div>

      <!-- Main Title -->
      <div class="space-y-2 max-w-4xl mx-auto">
        <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight">
          TaCoS Conference <span class="text-red-700">Trier 2027</span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto font-normal">
          The annual student conference for Computational Linguistics, Natural Language Processing, and related fields.
        </p>
      </div>

      <!-- Event Details Bar -->
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-sm sm:text-base text-slate-700 pt-2">
        <div class="inline-flex items-center gap-2 bg-white px-4 py-2 rounded-xl shadow-xs border border-slate-200 font-medium">
          <svg class="h-5 w-5 text-red-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>June 03rd – 05th, 2027</span>
        </div>

        <div class="inline-flex items-center gap-2 bg-white px-4 py-2 rounded-xl shadow-xs border border-slate-200 font-medium">
          <svg class="h-5 w-5 text-red-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <a href="https://www.uni-trier.de/" target="_blank" rel="noopener noreferrer" class="hover:text-red-700 transition">
            Trier University, Germany &rarr;
          </a>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap justify-center gap-3 pt-2">
        <a
          href={`${base}/registration`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-red-700 text-white font-semibold text-sm sm:text-base hover:bg-red-800 shadow-sm transition-all hover:shadow-md"
        >
          Registration Details
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href={`${base}/team`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white text-slate-700 font-semibold text-sm sm:text-base border border-slate-200 hover:bg-slate-50 transition-colors shadow-xs"
        >
          Meet the Organizers
        </a>
      </div>

    </section>

    <!-- Live Countdown Section -->
    <section class="max-w-3xl mx-auto">
      <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-slate-200 text-center space-y-4">
        <span class="text-xs uppercase font-bold tracking-widest text-red-700">
          Countdown to TaCoS 2027
        </span>
        <div class="grid grid-cols-4 gap-2 sm:gap-4 max-w-lg mx-auto">
          
          <div class="bg-slate-50 rounded-xl p-3 sm:p-4 border border-slate-100 flex flex-col items-center">
            <span class="countdown-days text-3xl sm:text-5xl font-extrabold text-slate-900 font-mono">--</span>
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1">Days</span>
          </div>

          <div class="bg-slate-50 rounded-xl p-3 sm:p-4 border border-slate-100 flex flex-col items-center">
            <span class="countdown-hours text-3xl sm:text-5xl font-extrabold text-slate-900 font-mono">--</span>
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1">Hours</span>
          </div>

          <div class="bg-slate-50 rounded-xl p-3 sm:p-4 border border-slate-100 flex flex-col items-center">
            <span class="countdown-minutes text-3xl sm:text-5xl font-extrabold text-slate-900 font-mono">--</span>
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1">Mins</span>
          </div>

          <div class="bg-slate-50 rounded-xl p-3 sm:p-4 border border-slate-100 flex flex-col items-center">
            <span class="countdown-seconds text-3xl sm:text-5xl font-extrabold text-red-700 font-mono">--</span>
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1">Secs</span>
          </div>

        </div>
        <p class="text-xs text-slate-500">
          Conference starts Thursday, June 03rd, 2027 at 08:00 AM CEST
        </p>
      </div>
    </section>

    <!-- Campus Hero Visual Banner -->
    <section class="max-w-5xl mx-auto">
      <div class="relative rounded-2xl overflow-hidden shadow-md border border-slate-200 group">
        <img
          src={`${base}/images/UT.jpg`}
          alt="Trier University Campus"
          class="w-full h-64 sm:h-80 lg:h-96 object-cover object-center group-hover:scale-[1.01] transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/20 to-transparent flex items-end p-6 sm:p-8">
          <div class="text-white space-y-1">
            <span class="inline-block text-xs font-semibold uppercase tracking-wider bg-white/20 backdrop-blur-md px-2.5 py-1 rounded-md mb-1">
              Host Location
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-white">Trier University</h2>
            <p class="text-sm text-slate-200 max-w-xl">
              Surrounded by Roman history and nature, Trier University's modern campus is ready to welcome students from across Europe.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="max-w-4xl mx-auto">
      <div class="bg-white rounded-2xl p-6 sm:p-10 shadow-sm border border-slate-200 space-y-6">
        <div class="border-b border-slate-100 pb-4">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">About TaCoS</h2>
          <p class="text-sm text-red-700 font-semibold tracking-wide uppercase mt-1">
            Tagung der Computerlinguistik-Studierenden
          </p>
        </div>

        <div class="space-y-4 text-slate-600 leading-relaxed text-base sm:text-lg">
          <p>
            The <strong>Tagung der Computerlinguistik-Studierenden (TaCoS)</strong> was first organized in 1992 and takes place once every year. It offers students of computational linguistics and adjacent fields a friendly, open forum to exchange research, discuss project ideas, and connect with peers during talks, workshops, and poster sessions.
          </p>
          <p>
            Hosted entirely by volunteer student teams at varying universities, participants traditionally receive accommodation and breakfast in exchange for a modest conference fee. In addition to student talks and renowned keynote lectures, the event features a vibrant social program to build long-lasting academic networks.
          </p>
        </div>

        <div class="pt-2 flex flex-wrap items-center justify-between gap-4 border-t border-slate-100">
          <a
            href="https://linguistik.computer/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-red-700 hover:text-red-800 transition"
          >
            <span>Explore Previous TaCoS Conferences</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          <a
            href="mailto:tacos@uni-trier.de"
            class="text-xs font-medium text-slate-500 hover:text-slate-800 transition"
          >
            Questions? Contact tacos@uni-trier.de
          </a>
        </div>
      </div>
    </section>

    <!-- Conference Navigation Hub (Replacing the 7 repeated yellow blocks) -->
    <section class="max-w-6xl mx-auto space-y-8">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Explore TaCoS 2027</h2>
        <p class="text-slate-600 text-sm sm:text-base max-w-xl mx-auto">
          Navigate through all conference sections, schedules, maps, and information.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featureCards.map((card) => (
          <a
            href={card.href}
            class="group bg-white rounded-2xl p-6 shadow-xs border border-slate-200/90 hover:border-red-300 hover:shadow-md hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between"
          >
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <div class="h-12 w-12 rounded-xl bg-red-50 text-red-700 flex items-center justify-center group-hover:bg-red-700 group-hover:text-white transition-colors duration-200">
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={card.icon} />
                </div>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 group-hover:bg-red-50 group-hover:text-red-700 transition-colors">
                  {card.badge}
                </span>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-red-700 transition-colors">
                  {card.title}
                </h3>
                <p class="text-sm text-slate-600 mt-1 leading-relaxed">
                  {card.desc}
                </p>
              </div>
            </div>
            
            <div class="pt-4 mt-4 border-t border-slate-100 flex items-center text-xs font-semibold text-red-700 group-hover:text-red-800">
              <span>Learn more</span>
              <svg class="h-3.5 w-3.5 ml-1 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
</Layout>

<script>
  const dest = new Date("2027-06-03T08:00:00").getTime();

  const daysEl = document.querySelector(".countdown-days");
  const hoursEl = document.querySelector(".countdown-hours");
  const minsEl = document.querySelector(".countdown-minutes");
  const secsEl = document.querySelector(".countdown-seconds");

  function updateCountdown() {
    const now = new Date().getTime();
    const diff = dest - now;

    if (diff <= 0) {
      if (daysEl) daysEl.textContent = "00";
      if (hoursEl) hoursEl.textContent = "00";
      if (minsEl) minsEl.textContent = "00";
      if (secsEl) secsEl.textContent = "00";
      return;
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);

    if (daysEl) daysEl.textContent = String(days).padStart(2, "0");
    if (hoursEl) hoursEl.textContent = String(hours).padStart(2, "0");
    if (minsEl) minsEl.textContent = String(minutes).padStart(2, "0");
    if (secsEl) secsEl.textContent = String(seconds).padStart(2, "0");
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
