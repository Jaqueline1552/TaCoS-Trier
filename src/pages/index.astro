---
import Layout from '../layout/layout.astro';

const base = "/TaCoS-Trier";

const links = [
  {
    href: `${base}/schedule`,
    title: "Schedule",
    desc: "Detailed timetable for talks, workshops, and dinner.",
  },
  {
    href: `${base}/speakers`,
    title: "Speakers",
    desc: "Keynote speakers from research and industry.",
  },
  {
    href: `${base}/registration`,
    title: "Registration",
    desc: "Registration details and conference attendance information.",
  },
  {
    href: `${base}/sponsors`,
    title: "Sponsors",
    desc: "Information for partners and supporting organizations.",
  },
  {
    href: `${base}/map`,
    title: "Campus Map",
    desc: "Directions and room locations on Campus I.",
  },
  {
    href: `${base}/team`,
    title: "Team",
    desc: "The student committee organizing TaCoS 2027 in Trier.",
  },
];
---

<Layout
  title="36. TaCoS Trier 2027 | Computational Linguistics Student Conference"
  description="TaCoS 2027 at Trier University, June 3 to 5, 2027. The annual student conference for computational linguistics."
  fullWidth={true}
>
  <!-- Hero Section with Campus Background -->
  <section class="relative min-h-[75vh] flex items-center justify-center bg-slate-900 text-white overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${base}/images/Campus_Oben.jpg');`}
      aria-hidden="true"
    ></div>

    <!-- Calm dark overlay for legibility -->
    <div class="absolute inset-0 bg-slate-950/65"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 py-20 text-center flex flex-col items-center">
      <p class="text-xs sm:text-sm font-semibold text-slate-300 uppercase tracking-widest mb-3">
        36th Student Conference for Computational Linguistics
      </p>

      <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold text-white tracking-tight leading-tight mb-3">
        TaCoS 2027
      </h1>

      <p class="text-xl sm:text-2xl text-slate-200 font-light mb-1">
        June 3rd to 5th, 2027
      </p>

      <p class="text-base sm:text-lg text-slate-300 font-normal mb-8">
        Universität Trier
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href={`${base}/registration`}
          class="px-6 py-3 rounded-lg bg-red-700 text-white font-medium text-sm hover:bg-red-600 transition-colors"
        >
          Registration
        </a>
        <a
          href={`${base}/schedule`}
          class="px-6 py-3 rounded-lg bg-white/10 border border-white/20 text-white font-medium text-sm hover:bg-white/20 transition-colors"
        >
          View Schedule
        </a>
      </div>
    </div>
  </section>

  <!-- Countdown Section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 -mt-10 relative z-20">
    <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xl shadow-slate-200/50 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="text-center sm:text-left">
        <span class="inline-block text-xs font-bold uppercase tracking-wider text-red-700 mb-1">
          Conference Countdown
        </span>
        <h2 class="text-base sm:text-lg font-bold text-slate-900 leading-tight">
          TaCoS 2027 in Trier
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Starts June 3, 2027 at 08:00 CEST
        </p>
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <div class="flex flex-col items-center">
          <div class="w-14 sm:w-16 h-14 sm:h-16 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-xs">
            <span class="countdown-days text-xl sm:text-2xl font-bold font-mono tabular-nums leading-none">--</span>
          </div>
          <span class="text-[10px] sm:text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1.5">Days</span>
        </div>

        <span class="text-slate-400 font-bold text-lg mb-4">:</span>

        <div class="flex flex-col items-center">
          <div class="w-14 sm:w-16 h-14 sm:h-16 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-xs">
            <span class="countdown-hours text-xl sm:text-2xl font-bold font-mono tabular-nums leading-none">--</span>
          </div>
          <span class="text-[10px] sm:text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1.5">Hours</span>
        </div>

        <span class="text-slate-400 font-bold text-lg mb-4">:</span>

        <div class="flex flex-col items-center">
          <div class="w-14 sm:w-16 h-14 sm:h-16 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-xs">
            <span class="countdown-minutes text-xl sm:text-2xl font-bold font-mono tabular-nums leading-none">--</span>
          </div>
          <span class="text-[10px] sm:text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1.5">Mins</span>
        </div>

        <span class="text-slate-400 font-bold text-lg mb-4">:</span>

        <div class="flex flex-col items-center">
          <div class="w-14 sm:w-16 h-14 sm:h-16 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-xs">
            <span class="countdown-seconds text-xl sm:text-2xl font-bold font-mono tabular-nums leading-none text-red-400">--</span>
          </div>
          <span class="text-[10px] sm:text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1.5">Secs</span>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      
      <!-- Left Column: Welcome and Links -->
      <div class="space-y-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight mb-3">
            See you in Trier
          </h2>
          <p class="text-slate-600 leading-relaxed">
            The student council (Fachschaft Computerlinguistik, Digital Humanities und Phonetik – CoDiPho) and organizing team at Trier University are hosting the 36th TaCoS in June 2027. Whether you want to present your thesis, listen to talks, or meet students from computational linguistics, NLP, and related fields, everyone is welcome.
          </p>
        </div>

        <div class="space-y-3 pt-2">
          <a
            href="https://www.uni-trier.de/"
            target="_blank"
            rel="noopener noreferrer"
            class="block p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition-colors"
          >
            <div class="text-sm font-semibold text-slate-900">Trier University</div>
            <div class="text-xs text-slate-500 mt-0.5">Learn more about the host university &rarr;</div>
          </a>

          <a
            href="https://linguistik.computer/"
            target="_blank"
            rel="noopener noreferrer"
            class="block p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition-colors"
          >
            <div class="text-sm font-semibold text-slate-900">Previous TaCoS Editions</div>
            <div class="text-xs text-slate-500 mt-0.5">Archive of past conferences on linguistik.computer &rarr;</div>
          </a>
        </div>
      </div>

      <!-- Right Column: What is TaCoS -->
      <div class="bg-white rounded-xl p-6 sm:p-8 border border-slate-200 space-y-4">
        <h3 class="text-xl font-bold text-slate-900">
          What is TaCoS?
        </h3>
        <p class="text-slate-600 text-sm leading-relaxed">
          The “Tagung der Computerlinguistik-Studierenden” (TaCoS) is the annual student conference for computational linguistics. First organized in 1992, it takes place once every year and offers students of computational linguistics, NLP, and adjacent fields a space to exchange ideas during talks and workshops. The conference is organized by teams of student volunteers at their university.
        </p>
        <p class="text-slate-600 text-sm leading-relaxed">
          At the center of the conference stand student talks, workshops, and poster sessions. Keynote lectures are also presented by invited speakers from academia and industry. In addition, a social program provides time for exchange and networking.
        </p>
      </div>

    </div>
  </section>

  <!-- Schedule Overview Section (Inverted Dark Slate Surface) -->
  <section class="bg-slate-900 text-white py-16 sm:py-20 border-y border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="mb-10 text-center sm:text-left">
        <span class="text-xs font-mono uppercase tracking-widest text-red-400 block mb-1">Program</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Schedule (Under Construction)</h2>
        <p class="text-slate-400 text-sm mt-1">Talk sessions and exact times will be published once the Call for Papers concludes.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Day 1 -->
        <div class="p-6 rounded-xl border border-slate-800 bg-slate-950/70">
          <div class="text-xs font-mono uppercase tracking-wider text-red-400 mb-1">Thursday, June 3</div>
          <h3 class="text-base font-bold text-white mb-3">Arrival and Opening</h3>
          <ul class="text-sm text-slate-300 space-y-2">
            <li>Arrival and check-in</li>
            <li>Welcome address</li>
            <li>Opening keynote lecture</li>
            <li>Evening get-together</li>
          </ul>
        </div>

        <!-- Day 2 -->
        <div class="p-6 rounded-xl border border-slate-800 bg-slate-950/70">
          <div class="text-xs font-mono uppercase tracking-wider text-red-400 mb-1">Friday, June 4</div>
          <h3 class="text-base font-bold text-white mb-3">Talks and Posters</h3>
          <ul class="text-sm text-slate-300 space-y-2">
            <li>Morning keynote lecture</li>
            <li>Student presentations</li>
            <li>Poster session</li>
            <li>Conference dinner</li>
          </ul>
        </div>

        <!-- Day 3 -->
        <div class="p-6 rounded-xl border border-slate-800 bg-slate-950/70">
          <div class="text-xs font-mono uppercase tracking-wider text-red-400 mb-1">Saturday, June 5</div>
          <h3 class="text-base font-bold text-white mb-3">Workshops and Closing</h3>
          <ul class="text-sm text-slate-300 space-y-2">
            <li>Practical workshops</li>
            <li>Student exchange and discussion</li>
            <li>Closing session and feedback</li>
            <li>Departure and farewell</li>
          </ul>
        </div>
      </div>

      <div class="mt-8 text-center sm:text-left">
        <a
          href={`${base}/schedule`}
          class="text-sm font-semibold text-red-400 hover:text-red-300 transition-colors"
        >
          View schedule &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Venue Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      
      <div class="space-y-5">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight mb-3">
            The Venue
          </h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            TaCoS 2027 takes place at Trier University on Campus I. All conference talks, workshops, and catering are located in the central lecture hall buildings on the Tarforst campus.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-slate-200 bg-white">
          <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Address</div>
          <address class="text-sm font-medium not-italic text-slate-900 leading-snug">
            Universität Trier<br />
            Campus I, Universitätsring 15<br />
            54296 Trier, Germany
          </address>
        </div>

        <div class="flex items-center gap-4 text-sm font-medium">
          <a
            href={`${base}/map`}
            class="text-red-700 hover:text-red-800 transition-colors"
          >
            Campus map and directions &rarr;
          </a>
        </div>
      </div>

      <!-- Clean 2-photo display -->
      <div class="grid grid-cols-2 gap-4">
        <img
          src={`${base}/images/Campus_Bibliothek.jpg`}
          alt="Trier University Library"
          class="w-full h-48 sm:h-56 object-cover rounded-xl border border-slate-200"
        />
        <img
          src={`${base}/images/Gebaude.jpg`}
          alt="Trier University Campus Architecture"
          class="w-full h-48 sm:h-56 object-cover object-top rounded-xl border border-slate-200"
        />
      </div>

    </div>
  </section>

  <!-- Host City Section: Trier -->
  <section class="border-t border-slate-200 bg-slate-50/70 py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        
        <!-- Photo of Porta Nigra -->
        <div class="order-2 lg:order-1">
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
            <img
              src={`${base}/images/porta_nigra.JPG`}
              alt="Porta Nigra Roman City Gate in Trier"
              class="w-full h-72 sm:h-96 object-cover object-center"
            />
            <div class="p-3 sm:p-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500">
              <span class="font-medium text-slate-700">Porta Nigra (ca. 170 AD)</span>
              <span>Photo: Roland Morgen</span>
            </div>
          </div>
        </div>

        <!-- City Information -->
        <div class="order-1 lg:order-2 space-y-4">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-red-700 block mb-1">Host City</span>
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight mb-3">
              Germany's Oldest City
            </h2>
            <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
              Founded in 16 BC as <em>Augusta Treverorum</em>, Trier looks back on more than 2,000 years of history. Located along the Moselle river, the city features Roman monuments designated as UNESCO World Heritage sites, including Porta Nigra, the Roman imperial baths, and the amphitheater.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Quick Links Hub -->
  <section class="bg-white border-y border-slate-200 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="mb-8">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          Conference Information
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {links.map((item) => (
          <a
            href={item.href}
            class="block p-5 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white hover:border-slate-300 transition-colors"
          >
            <h3 class="font-bold text-slate-900 text-base mb-1">
              {item.title}
            </h3>
            <p class="text-sm text-slate-600">
              {item.desc}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Sponsors Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 text-center">
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight mb-2">
      Sponsors
    </h2>
    <p class="text-sm text-slate-600 max-w-lg mx-auto mb-8">
      TaCoS 2027 is supported by Trier University, the student council CoDiPho (Fachschaft Computerlinguistik, Digital Humanities und Phonetik), and our sponsors.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4 py-4 max-w-3xl mx-auto">
      <div class="px-6 py-4 rounded-lg border border-slate-200 bg-white font-medium text-slate-800 text-sm">
        Universität Trier
      </div>
      <div class="px-6 py-4 rounded-lg border border-slate-200 bg-white font-medium text-slate-800 text-sm">
        FSR CoDiPho Trier
      </div>
      <a
        href={`${base}/sponsors`}
        class="px-5 py-3.5 rounded-lg border-2 border-dashed border-slate-300 bg-slate-50/50 hover:border-slate-400 font-mono text-xs uppercase tracking-wider text-slate-500 transition-colors"
      >
        + Your Logo Here
      </a>
      <a
        href={`${base}/sponsors`}
        class="px-5 py-3.5 rounded-lg border-2 border-dashed border-slate-300 bg-slate-50/50 hover:border-slate-400 font-mono text-xs uppercase tracking-wider text-slate-500 transition-colors"
      >
        + Your Logo Here
      </a>
    </div>

    <p class="text-xs text-slate-500 mt-6">
      Interested in supporting the conference? Learn more on our <a href={`${base}/sponsors`} class="text-slate-800 underline">sponsors page</a> or contact the team on social media.
    </p>
  </section>

</Layout>

<script>
  const dest = new Date("2027-06-03T08:00:00").getTime();

  const daysEl = document.querySelector(".countdown-days");
  const hoursEl = document.querySelector(".countdown-hours");
  const minsEl = document.querySelector(".countdown-minutes");
  const secsEl = document.querySelector(".countdown-seconds");

  function updateCountdown() {
    const now = new Date().getTime();
    const diff = dest - now;

    if (diff <= 0) {
      if (daysEl) daysEl.textContent = "00";
      if (hoursEl) hoursEl.textContent = "00";
      if (minsEl) minsEl.textContent = "00";
      if (secsEl) secsEl.textContent = "00";
      return;
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);

    if (daysEl) daysEl.textContent = String(days).padStart(2, "0");
    if (hoursEl) hoursEl.textContent = String(hours).padStart(2, "0");
    if (minsEl) minsEl.textContent = String(minutes).padStart(2, "0");
    if (secsEl) secsEl.textContent = String(seconds).padStart(2, "0");
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
