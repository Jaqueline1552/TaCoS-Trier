---
import Layout from '../../layout/layout-de.astro';

const days = [
  {
    day: "Tag 1",
    label: "Donnerstag, 03. Juni",
    items: [
      {
        period: "Nachmittag",
        title: "Anreise und Check-in",
        desc: "Anmeldebüro auf Campus I geöffnet. Ausgabe von Tagungstaschen und Namensschildern.",
      },
      {
        period: "Spätnachmittag",
        title: "Begrüßung und Eröffnungs-Keynote",
        desc: "Offizielle Eröffnung durch das studentische Organisationsteam und anschließende Keynote.",
      },
      {
        period: "Abend",
        title: "Kennenlern-Abend",
        desc: "Gemeinsames Abendessen zum Ankommen und Vernetzen.",
      },
    ],
  },
  {
    day: "Tag 2",
    label: "Freitag, 04. Juni",
    items: [
      {
        period: "Vormittag",
        title: "Keynote und Vortragsblöcke",
        desc: "Zweite Keynote und erster Block studentischer Fachvorträge.",
      },
      {
        period: "Mittag",
        title: "Mittagspause",
        desc: "Gemeinsames Mittagessen in der Universitätsmensa.",
      },
      {
        period: "Nachmittag",
        title: "Postersession und Vorträge",
        desc: "Forschungsposter-Präsentationen und parallele Vortragstracks.",
      },
      {
        period: "Abend",
        title: "Konferenzabend und Stadtrundgang",
        desc: "Gemeinsames Abendessen und Erkundung der historischen Trierer Altstadt.",
      },
    ],
  },
  {
    day: "Tag 3",
    label: "Samstag, 05. Juni",
    items: [
      {
        period: "Vormittag",
        title: "Workshops und Abschlussvorträge",
        desc: "Praktische Hands-on-Workshops und abschließende Fachvorträge.",
      },
      {
        period: "Mittag",
        title: "Abschlussplenum und Feedback",
        desc: "Gemeinsamer Rückblick, Feedbackrunde und Verabschiedung aller Teilnehmenden.",
      },
      {
        period: "Nachmittag",
        title: "Verabschiedung und Abreise",
        desc: "Offizieller Abschluss, Gepäckabholung und Verabschiedung.",
      },
    ],
  },
];

const gcalUrl = "https://calendar.google.com/calendar/render?action=TEMPLATE&text=36.+TaCoS+Trier+2027&dates=20270603T080000Z/20270605T140000Z&details=36.+Tagung+der+Computerlinguistik-Studierenden+an+der+Universit%C3%A4t+Trier.&location=Universit%C3%A4t+Trier,+Campus+I";
---

<Layout
  title="Programm | 36. TaCoS Trier 2027"
  description="Vorläufiges Programm der 36. TaCoS an der Universität Trier."
>
  <div class="space-y-12 py-4">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 tracking-tight">
        Programm
      </h1>
      <p class="text-slate-600 text-base sm:text-lg">
        Vorläufiger Zeitplan der TaCoS 2027 an der Universität Trier (Campus I).
      </p>

      <!-- Kalender-Aktionen -->
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
        <a
          href={gcalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white text-slate-700 hover:text-red-700 border border-slate-200 text-xs sm:text-sm font-semibold shadow-xs hover:bg-slate-50 transition"
        >
          <svg class="h-4 w-4 text-red-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Termin in Google Calendar speichern</span>
        </a>

        <button
          id="btn-download-ics"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white text-slate-700 hover:text-red-700 border border-slate-200 text-xs sm:text-sm font-semibold shadow-xs hover:bg-slate-50 transition cursor-pointer"
        >
          <svg class="h-4 w-4 text-red-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>.ics-Datei herunterladen</span>
        </button>
      </div>
    </div>

    <!-- Status-Banner: Im Aufbau -->
    <div class="max-w-4xl mx-auto bg-amber-50/80 border border-amber-200 rounded-xl p-5 text-center sm:text-left flex flex-col sm:flex-row items-center sm:items-start gap-4">
      <div class="h-9 w-9 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center shrink-0 font-bold text-sm">
        i
      </div>
      <div class="space-y-1">
        <h2 class="text-sm font-bold text-amber-950">Detaillierter Zeitplan in Vorbereitung</h2>
        <p class="text-xs sm:text-sm text-amber-900 leading-relaxed">
          Die genauen Uhrzeiten, Vortragstitel und Referierenden stehen noch nicht fest. Der detaillierte Zeitplan folgt nach dem Call for Papers Anfang 2027.
        </p>
      </div>
    </div>

    <!-- Drei-Tage-Raster -->
    <section class="max-w-4xl mx-auto space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {days.map((d) => (
          <div class="bg-white rounded-xl border border-slate-200 p-6 flex flex-col justify-between">
            <div>
              <span class="text-xs font-mono uppercase tracking-wider text-red-700 block mb-1">
                {d.day}
              </span>
              <h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3 mb-4">
                {d.label}
              </h2>
              
              <div class="space-y-4">
                {d.items.map((it) => (
                  <div class="space-y-0.5">
                    <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400 block">
                      {it.period}
                    </span>
                    <h3 class="text-sm font-bold text-slate-900">
                      {it.title}
                    </h3>
                    <p class="text-xs text-slate-600 leading-relaxed">
                      {it.desc}
                    </p>
                  </div>
                ))}
              </div>
            </div>

            <div class="mt-6 pt-3 border-t border-slate-100 text-[11px] text-slate-400">
              Campus I, Universität Trier
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Call for Papers Hinweis -->
    <section class="max-w-4xl mx-auto bg-slate-50 rounded-xl border border-slate-200 p-6 text-center space-y-2">
      <h2 class="text-base font-bold text-slate-900">Call for Papers</h2>
      <p class="text-xs sm:text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
        Studierende aller Semesterstufen (Bachelor, Master, Promotion) sind herzlich eingeladen, Vorträge oder Poster einzureichen. Die Einreichungsfristen und Richtlinien werden rechtzeitig hier veröffentlicht.
      </p>
    </section>

  </div>
</Layout>

<script>
  const btnIcs = document.getElementById("btn-download-ics");
  if (btnIcs) {
    btnIcs.addEventListener("click", () => {
      const icsData = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//TaCoS 2027//Trier University//DE",
        "BEGIN:VEVENT",
        "UID:tacos2027-trier-dates@linguistik.computer",
        "DTSTAMP:20261025T000000Z",
        "DTSTART:20270603T080000Z",
        "DTEND:20270605T140000Z",
        "SUMMARY:36. TaCoS Trier 2027",
        "DESCRIPTION:36. Tagung der Computerlinguistik-Studierenden an der Universität Trier.",
        "LOCATION:Universität Trier Campus I, Universitätsring 15, 54296 Trier, Deutschland",
        "END:VEVENT",
        "END:VCALENDAR"
      ].join("\r\n");

      const blob = new Blob([icsData], { type: "text/calendar;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", "tacos-2027-trier.ics");
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });
  }
</script>
