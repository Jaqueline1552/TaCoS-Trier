---
import Layout from '../../layout/layout-de.astro'

const days = [
  {
    day: "Tag 1",
    date: "Donnerstag, 03. Juni 2027",
    highlights: [
      { time: "12:00 – 14:00", title: "Anreise, Anmeldung & Check-in", desc: "Anmeldebüro auf Campus II geöffnet. Ausgabe der Tagungstaschen, Namensschilder und Schlafplatz-Zuweisung." },
      { time: "14:00 – 14:30", title: "Offizielle Eröffnung", desc: "Begrüßung durch das Trierer Organisationsteam und Vertreter*innen der Universität." },
      { time: "14:30 – 15:45", title: "Eröffnungs-Keynote", desc: "Plenarvortrag einer eingeladenen Persönlichkeit aus der Wissenschaft." },
      { time: "16:00 – 18:00", title: "Vortragsblock I (Studierende)", desc: "Erste Vortragsreihe mit Beiträgen von teilnehmenden Studierenden." },
      { time: "Ab 19:00", title: "Kennenlern-Abend & Abendessen", desc: "Gemeinsamer geselliger Ausklang zum Kennenlernen und Vernetzen." },
    ]
  },
  {
    day: "Tag 2",
    date: "Freitag, 04. Juni 2027",
    highlights: [
      { time: "09:00 – 10:15", title: "Morgen-Keynote", desc: "Fachvortrag zu aktuellen Trends in der Sprachverarbeitung und KI." },
      { time: "10:30 – 12:30", title: "Praxis-Workshops", desc: "Hands-on Tutorials und thematische Workshops in den Rechnerpools." },
      { time: "12:30 – 14:00", title: "Mittagspause & Austausch", desc: "Gemeinsames Mittagessen in der Universitätsmensa." },
      { time: "14:00 – 16:00", title: "Vortragsblock II & Postersession", desc: "Präsentationen studentischer Forschungsprojekte und Posterausstellung." },
      { time: "Ab 18:00", title: "Konferenzabend & Rahmenprogramm", desc: "Social Event und Erkundung der ältesten Stadt Deutschlands." },
    ]
  },
  {
    day: "Tag 3",
    date: "Samstag, 05. Juni 2027",
    highlights: [
      { time: "09:30 – 11:30", title: "Vortragsblock III (Studierende)", desc: "Abschließende Vortragsrunde mit weiteren studentischen Projekten." },
      { time: "11:45 – 13:00", title: "TaCoS-Vollversammlung", desc: "Besprechung von Konferenzthemen und Wahl des Austragungsortes für die TaCoS 2028." },
      { time: "13:00 – 13:30", title: "Abschlussworte & Abreise", desc: "Offizielles Konferenzende und Verabschiedung." },
    ]
  }
];
---

<Layout
  title="Programm & Ablauf | 36. TaCoS Trier 2027"
  description="Das vorläufige Drei-Tages-Programm der 36. TaCoS an der Universität Trier."
>
  <div class="space-y-16 py-4">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 text-red-800 text-xs font-semibold tracking-wide border border-red-200">
        Konferenzprogramm
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Programm & Ablauf
      </h1>
      <p class="text-slate-600 text-base sm:text-lg">
        Drei Tage voller Vorträge, Workshops, Posterpräsentationen und Austausch an der Universität Trier.
      </p>
    </div>

    <!-- Alert / Notice -->
    <div class="max-w-3xl mx-auto bg-slate-100/80 border border-slate-200 rounded-2xl p-4 text-center">
      <p class="text-xs sm:text-sm text-slate-600">
        ℹ️ <strong>Vorläufige Übersicht:</strong> Genaue Vortragstitel, Referent*innen und Raumangaben werden nach Abschluss des Call for Papers veröffentlicht.
      </p>
    </div>

    <!-- 3 Days Schedule -->
    <section class="max-w-4xl mx-auto space-y-8">
      {days.map((dayPlan) => (
        <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-xs border border-slate-200 space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-4 gap-2">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-red-700">{dayPlan.day}</span>
              <h2 class="text-2xl font-bold text-slate-900">{dayPlan.date}</h2>
            </div>
            <span class="text-xs font-medium text-slate-500 bg-slate-100 px-3 py-1 rounded-full self-start sm:self-auto">
              Campus II, Universität Trier
            </span>
          </div>

          <div class="space-y-4">
            {dayPlan.highlights.map((item) => (
              <div class="flex flex-col sm:flex-row sm:items-start gap-2 sm:gap-6 p-3 rounded-xl hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900 font-mono sm:w-36 shrink-0 sm:pt-0.5">
                  {item.time}
                </span>
                <div class="space-y-0.5">
                  <h3 class="text-base font-bold text-slate-900">{item.title}</h3>
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

  </div>
</Layout>
