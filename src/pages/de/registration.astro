---
import Layout from '../../layout/layout-de.astro';

const base = "/TaCoS-Trier";

const benefits = [
  {
    title: "Alle Fachvorträge und Keynotes",
    desc: "Freier Zugang zu allen Keynote-Vorträgen, studentischen Präsentationen und Workshops.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`,
  },
  {
    title: "Frühstück und Kaffeepausen",
    desc: "Tägliches Frühstück und Pausenverpflegung zwischen den Vortragsblöcken.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
  },
  {
    title: "Rahmenprogramm und Stadtführung",
    desc: "Kennenlern-Abend, Konferenzdinner und Stadtführung durch das historische Trier.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  },
];
---

<Layout
  title="Teilnahme | 36. TaCoS Trier 2027"
  description="Informationen zu Anmeldung, Gebühren und Teilnahme an der 36. TaCoS an der Universität Trier."
>
  <div class="space-y-12 py-4">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 tracking-tight">
        Teilnahme
      </h1>
      <p class="text-slate-600 text-base sm:text-lg">
        Die TaCoS steht Studierenden aller Hochschulen und verwandter Fachbereiche offen (Computerlinguistik, NLP, Informatik, Linguistik, Digital Humanities, Phonetik).
      </p>
    </div>

    <!-- Status-Banner: Im Aufbau -->
    <div class="max-w-3xl mx-auto bg-amber-50/80 border border-amber-200 rounded-xl p-6 sm:p-8 text-center space-y-3">
      <div class="inline-block text-xs font-mono uppercase tracking-wider text-amber-800 font-bold">
        Status: In Vorbereitung
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-amber-950">Anmeldung öffnet Anfang 2027</h2>
      <p class="text-xs sm:text-sm text-amber-900 max-w-xl mx-auto leading-relaxed">
        Die Anmeldung öffnet, sobald der Ablauf und das Buchungssystem stehen. Nach TaCoS-Tradition werden die Teilnahmegebühren so gering wie möglich gehalten, um allen Studierenden die Teilnahme zu ermöglichen. Ankündigungen erfolgen hier und auf Social Media.
      </p>
      <div class="pt-3 flex flex-wrap justify-center gap-3">
        <a
          href="https://www.instagram.com/tacosconference/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white border border-amber-200 hover:bg-amber-100/50 text-slate-800 text-xs font-semibold transition"
        >
          <span>Instagram: @tacosconference</span>
        </a>
        <a
          href="https://www.linkedin.com/company/tacosconference/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white border border-amber-200 hover:bg-amber-100/50 text-slate-800 text-xs font-semibold transition"
        >
          <span>LinkedIn: tacosconference</span>
        </a>
      </div>
    </div>

    <!-- Was ist enthalten -->
    <section class="max-w-4xl mx-auto space-y-6">
      <div class="text-center">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900">Was ist im Beitrag enthalten?</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {benefits.map((item) => (
          <div class="bg-white rounded-xl p-6 border border-slate-200 flex flex-col items-start gap-3">
            <div class="h-10 w-10 rounded-lg bg-red-50 text-red-700 flex items-center justify-center shrink-0">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={item.icon} />
            </div>
            <div class="space-y-1">
              <h3 class="text-base font-bold text-slate-900">{item.title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-3xl mx-auto bg-white rounded-xl p-6 sm:p-8 border border-slate-200 space-y-5">
      <h3 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3">Häufige Fragen</h3>
      
      <div class="space-y-4 text-sm text-slate-600">
        <div>
          <h4 class="font-bold text-slate-900">Muss ich einen Vortrag halten, um teilzunehmen?</h4>
          <p class="mt-1 text-xs sm:text-sm">Nein. Einreichungen für Vorträge oder Workshops sind willkommen, aber reine Zuhörerinnen und Zuhörer sind genauso gern gesehen.</p>
        </div>

        <div>
          <h4 class="font-bold text-slate-900">Werden Hinweise zu Unterkünften veröffentlicht?</h4>
          <p class="mt-1 text-xs sm:text-sm">Ja. Informationen und Empfehlungen zu Übernachtungsmöglichkeiten in Trier werden rechtzeitig vor Beginn der Anmeldung auf dieser Website geteilt.</p>
        </div>

        <div>
          <h4 class="font-bold text-slate-900">Können Fahrtkosten erstattet werden?</h4>
          <p class="mt-1 text-xs sm:text-sm">Viele Fachschaften oder Institute bezuschussen die Fahrt zu Fachtagungen. Fragt am besten bei eurer Fachschaft vor Ort nach.</p>
        </div>
      </div>
    </section>

  </div>
</Layout>
