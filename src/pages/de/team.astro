---
import Layout from '../../layout/layout-de.astro'

const base = "/TaCoS-Trier";

const leadOrganizers = [
  {
    name: "Jaqueline Pauli",
    role: "Hauptorganisation",
    affiliation: "Computerlinguistik, Universität Trier",
    image: `${base}/images/PB.png`,
  },
  {
    name: "Iftakharul Islam",
    role: "Hauptorganisation",
    affiliation: "Computerlinguistik, Universität Trier",
    image: `${base}/images/PB.png`,
  },
];

const teamMembers = [
  { name: "Lotta", role: "Organisationsteam", image: `${base}/images/PB.png` },
  { name: "Selin", role: "Organisationsteam", image: `${base}/images/PB.png` },
  { name: "Victoria", role: "Organisationsteam", image: `${base}/images/PB.png` },
  { name: "Siddharth", role: "Organisationsteam", image: `${base}/images/PB.png` },
  { name: "Emrehan", role: "Organisationsteam", image: `${base}/images/PB.png` },
  { name: "Aloyse", role: "Organisationsteam", image: `${base}/images/PB.png` },
  { name: "Juan", role: "Organisationsteam", image: `${base}/images/PB.png` },
  { name: "Jithin", role: "Organisationsteam", image: `${base}/images/PB.png` },
  { name: "Akila", role: "Organisationsteam", image: `${base}/images/PB.png` },
];
---

<Layout
  title="Organisationsteam | 36. TaCoS Trier 2027"
  description="Lerne das studentische Organisationsteam der 36. TaCoS an der Universität Trier kennen."
>
  <div class="space-y-16 py-4">

    <!-- Page Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 text-red-800 text-xs font-semibold tracking-wide border border-red-200">
        Studentische Initiative
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Das Organisationsteam
      </h1>
      <p class="text-slate-600 text-base sm:text-lg">
        Die TaCoS 2027 wird von engagierten Studierenden der Universität Trier ehrenamtlich organisiert, um eine unvergessliche Tagung auf die Beine zu stellen.
      </p>
    </div>

    <!-- Lead Organizers -->
    <section class="space-y-8">
      <div class="text-center">
        <h2 class="text-2xl font-bold text-slate-900">Hauptorganisation</h2>
        <p class="text-sm text-slate-500 mt-1">Gesamtleitung und Koordination</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
        {leadOrganizers.map((person) => (
          <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-xs border border-slate-200 hover:shadow-md hover:border-red-200 transition-all text-center flex flex-col items-center">
            <div class="relative mb-5">
              <img
                src={person.image}
                alt={person.name}
                class="w-32 h-32 sm:w-36 sm:h-36 rounded-full object-cover ring-4 ring-red-50 shadow-sm"
              />
              <span class="absolute bottom-0 right-0 bg-red-700 text-white text-[11px] font-bold px-2.5 py-0.5 rounded-full shadow-xs">
                Leitung
              </span>
            </div>
            <h3 class="text-xl font-bold text-slate-900">{person.name}</h3>
            <p class="text-sm font-semibold text-red-700 mt-0.5">{person.role}</p>
            <p class="text-xs text-slate-500 mt-2">{person.affiliation}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Organizing Committee -->
    <section class="space-y-8">
      <div class="text-center">
        <h2 class="text-2xl font-bold text-slate-900">Weitere Teammitglieder</h2>
        <p class="text-sm text-slate-500 mt-1">Programm, Logistik, Catering, Workshops & Begleitung</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {teamMembers.map((member) => (
          <div class="bg-white rounded-2xl p-6 shadow-xs border border-slate-200 hover:shadow-md hover:border-red-200 transition-all text-center flex flex-col items-center group">
            <img
              src={member.image}
              alt={member.name}
              class="w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover ring-2 ring-slate-100 group-hover:ring-red-100 shadow-xs mb-4 transition-all"
            />
            <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-red-700 transition-colors">
              {member.name}
            </h3>
            <p class="text-xs font-medium text-slate-500 mt-1">
              {member.role}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Volunteer CTA -->
    <section class="max-w-2xl mx-auto bg-white rounded-2xl p-8 border border-slate-200 shadow-xs text-center space-y-4">
      <h3 class="text-xl font-bold text-slate-900">Möchtest du unterstützen?</h3>
      <p class="text-sm text-slate-600 leading-relaxed">
        Wir freuen uns immer über Helfer*innen für die Konferenztage (Anmeldung, Catering, Technik, Betreuung).
      </p>
      <a
        href="mailto:tacos@uni-trier.de"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-red-700 text-white font-semibold text-sm hover:bg-red-800 transition"
      >
        <span>Melde dich bei uns</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </section>

  </div>
</Layout>
