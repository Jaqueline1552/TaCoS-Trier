---
import Layout from '../../layout/layout-de.astro'

const campusMapUrl = "https://www.uni-trier.de/fileadmin/organisation/Presse/Lageplaene/Lageplan202408_CampusI.svg";
---

<Layout
  title="Campusplan | 36. TaCoS Trier 2027"
  description="Campusplan, interaktive Karte und Anreiseinformationen für die 36. TaCoS an der Universität Trier."
>
  <div class="space-y-12 py-4 max-w-5xl mx-auto">

    <!-- Header -->
    <div class="text-center space-y-3">
      <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 tracking-tight">
        Campusplan
      </h1>
      <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto">
        Die TaCoS 2027 findet auf dem <strong>Campus I der Universität Trier</strong> statt (Universitätsring 15, 54296 Trier).
      </p>
    </div>

    <!-- Anreise -->
    <section class="bg-white rounded-xl border border-slate-200 p-6 sm:p-8">
      <h2 class="text-lg font-bold text-slate-900 mb-1">Anreise zu Campus I</h2>
      <p class="text-xs text-slate-500 mb-6">Öffentlicher Nahverkehr ab Trier Hauptbahnhof und Stadtzentrum</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm">
        <div class="space-y-2">
          <h3 class="font-bold text-slate-900">Mit der Bahn</h3>
          <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">
            Zielbahnhof ist Trier Hbf mit regelmäßigen Regionalverbindungen nach Koblenz, Saarbrücken, Mannheim und Luxemburg.
          </p>
          <div class="text-xs text-slate-500">Zielbahnhof: Trier Hbf</div>
        </div>

        <div class="space-y-2">
          <h3 class="font-bold text-slate-900">Mit dem Bus</h3>
          <ul class="text-xs sm:text-sm text-slate-600 space-y-1">
            <li><strong>Ab Hauptbahnhof (Hbf):</strong> Linien <strong>3</strong> und <strong>13</strong></li>
            <li><strong>Ab Porta Nigra:</strong> Linien <strong>4</strong> und <strong>14</strong></li>
          </ul>
          <p class="text-xs text-slate-500 pt-1">
            Alle Linien fahren direkt zur Haltestelle <em>„Universität“</em> (Fahrzeit ca. 15–20 Minuten).
          </p>
        </div>
      </div>
    </section>

    <!-- Interaktive Karte -->
    <section class="bg-white rounded-xl border border-slate-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-base font-bold text-slate-900">Interaktive Karte</h2>
          <p class="text-xs text-slate-500">Campus I und Umgebung</p>
        </div>
        <a
          href="https://www.openstreetmap.org/?mlat=49.7460&mlon=6.6865#map=16/49.7460/6.6865"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold text-slate-700 hover:text-red-700 inline-flex items-center gap-1 transition"
        >
          <span>In OpenStreetMap öffnen</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <div class="w-full h-80 sm:h-96 relative bg-slate-100">
        <iframe
          title="Universität Trier Campus I Karte"
          width="100%"
          height="100%"
          class="border-0 w-full h-full"
          loading="lazy"
          src="https://www.openstreetmap.org/export/embed.html?bbox=6.6660%2C49.7360%2C6.7060%2C49.7560&amp;layer=mapnik&amp;marker=49.7460%2C6.6865"
        ></iframe>
      </div>

      <div class="px-6 py-3 bg-slate-50/50 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500">
        <span>Adresse: Campus I, Universitätsring 15, 54296 Trier</span>
        <span>Koordinaten: 49.7460° N, 6.6865° O</span>
      </div>
    </section>

    <!-- Campus I Lageplan -->
    <section class="bg-white rounded-xl border border-slate-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-base font-bold text-slate-900">Campus I Lageplan</h2>
          <p class="text-xs text-slate-500">Offizieller Lageplan bereitgestellt von der Universitätsverwaltung Trier</p>
        </div>
        <a
          href={campusMapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold text-slate-700 hover:text-red-700 inline-flex items-center gap-1 transition"
        >
          <span>Lageplan öffnen (SVG)</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <div class="p-6 bg-slate-50/50 flex items-center justify-center">
        <img
          src={campusMapUrl}
          alt="Universität Trier Campus I Lageplan"
          class="max-h-[520px] w-auto object-contain rounded-lg"
          loading="lazy"
        />
      </div>
    </section>

  </div>
</Layout>
