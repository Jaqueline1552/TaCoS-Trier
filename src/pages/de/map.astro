---
import Layout from '../../layout/layout-de.astro'

const base = "/TaCoS-Trier";

const maps = [
  {
    title: "Campus II – Übersicht",
    desc: "Hauptveranstaltungsort für Vorträge, Workshops und Quartier der TaCoS 2027.",
    url: "https://www.uni-trier.de/fileadmin/organisation/Presse/Lageplaene/Lageplan202408_CampusII.svg",
    badge: "Hauptort",
  },
  {
    title: "Raumplan Gebäude F / H / K",
    desc: "Hörsäle, Seminarräume und PC-Pools auf Campus II.",
    url: "https://www.uni-trier.de/fileadmin/organisation/Presse/Lageplaene/Raumplan202405_UT_Gebaeude-FHHZK.svg",
    badge: "Raumplan",
  },
  {
    title: "Campus I – Hauptcampus",
    desc: "Zentrale Universitätsverwaltung, Universitätsbibliothek und Hauptmensa.",
    url: "https://www.uni-trier.de/fileadmin/organisation/Presse/Lageplaene/Lageplan202408_CampusI.svg",
    badge: "Campus I",
  },
];
---

<Layout
  title="Lagepläne & Orientierung | 36. TaCoS Trier 2027"
  description="Lagepläne, Raumübersichten und Anreiseinformationen für die 36. TaCoS an der Universität Trier."
>
  <div class="space-y-16 py-4">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 text-red-800 text-xs font-semibold tracking-wide border border-red-200">
        Orientierung & Anreise
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Lagepläne & Orientierung
      </h1>
      <p class="text-slate-600 text-base sm:text-lg">
        Die TaCoS 2027 findet vorwiegend auf dem <strong>Campus II der Universität Trier</strong> statt. Hier findest du offizielle Lage- und Gebäudepläne.
      </p>
    </div>

    <!-- Transit Information Box -->
    <section class="max-w-4xl mx-auto bg-white rounded-2xl p-6 sm:p-8 shadow-xs border border-slate-200">
      <div class="flex items-center gap-3 border-b border-slate-100 pb-3 mb-4">
        <div class="h-10 w-10 rounded-xl bg-red-50 text-red-700 flex items-center justify-center">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-bold text-slate-900">Anreise zu Campus II</h3>
          <span class="text-xs text-slate-500">Öffentlicher Nahverkehr ab Trier Hauptbahnhof</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm text-slate-600">
        <div class="bg-slate-50 p-4 rounded-xl">
          <span class="font-bold text-slate-900 block mb-1">🚆 Mit der Bahn</span>
          <p class="text-xs leading-relaxed">Zielbahnhof ist Trier Hbf mit regelmäßigen Verbindungen nach Koblenz, Saarbrücken, Mannheim und Luxemburg.</p>
        </div>
        <div class="bg-slate-50 p-4 rounded-xl">
          <span class="font-bold text-slate-900 block mb-1">🚌 Mit dem Bus</span>
          <p class="text-xs leading-relaxed">Die Buslinien <strong>3</strong>, <strong>4</strong> und <strong>30</strong> fahren direkt ab Trier Hbf zur Haltestelle <em>"Campus II"</em> bzw. <em>"Universität"</em> (Fahrzeit ca. 15–20 Min.).</p>
        </div>
        <div class="bg-slate-50 p-4 rounded-xl">
          <span class="font-bold text-slate-900 block mb-1">🚗 Mit dem Auto</span>
          <p class="text-xs leading-relaxed">Über die A64 / A602 Richtung Trier, Ausfahrt <em>Universität</em>. Kostenlose Besucherparkplätze stehen auf Campus II zur Verfügung.</p>
        </div>
      </div>
    </section>

    <!-- Site Plans Grid -->
    <section class="max-w-5xl mx-auto space-y-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {maps.map((map) => (
          <div class="bg-white rounded-2xl shadow-xs border border-slate-200 overflow-hidden flex flex-col justify-between hover:shadow-md transition-all">
            <div class="p-6 border-b border-slate-100 flex items-start justify-between gap-4">
              <div>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-red-50 text-red-700 inline-block mb-1">
                  {map.badge}
                </span>
                <h3 class="text-lg font-bold text-slate-900">{map.title}</h3>
                <p class="text-xs text-slate-500 mt-1">{map.desc}</p>
              </div>
              <a
                href={map.url}
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 p-2 rounded-lg bg-slate-100 text-slate-600 hover:text-red-700 hover:bg-red-50 transition"
                title="Vollbild in neuem Tab öffnen"
              >
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>

            <div class="p-4 bg-slate-50 flex items-center justify-center min-h-72">
              <img
                src={map.url}
                alt={map.title}
                class="max-h-80 w-auto object-contain rounded-lg"
                loading="lazy"
              />
            </div>

            <div class="p-4 bg-white border-t border-slate-100 text-right">
              <a
                href={map.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-semibold text-red-700 hover:text-red-800 inline-flex items-center gap-1"
              >
                <span>Vollständigen Lageplan öffnen</span>
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>
