---
import Layout from '../../layout/layout-de.astro';

const base = "/TaCoS-Trier";
---

<Layout
  title="Referierende | 36. TaCoS Trier 2027"
  description="Keynotes und studentische Beiträge der 36. TaCoS an der Universität Trier."
>
  <div class="space-y-12 py-4 max-w-4xl mx-auto">

    <!-- Header -->
    <div class="text-center space-y-3">
      <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 tracking-tight">
        Referierende
      </h1>
      <p class="text-slate-600 text-base sm:text-lg">
        Keynote-Vorträge und studentische Präsentationen der TaCoS 2027 in Trier.
      </p>
    </div>

    <!-- Status-Hinweis: Keynotes werden angekündigt -->
    <div class="bg-amber-50/80 border border-amber-200 rounded-xl p-6 sm:p-8 text-center sm:text-left flex flex-col sm:flex-row items-center sm:items-start gap-5">
      <div class="h-10 w-10 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center shrink-0 font-bold text-base">
        i
      </div>
      <div class="space-y-2">
        <h2 class="text-base font-bold text-amber-950">Keynote-Speaker werden angekündigt</h2>
        <p class="text-xs sm:text-sm text-amber-900 leading-relaxed">
          Die Einladungen und Abstimmungen mit Referierenden aus Wissenschaft und Praxis laufen derzeit. Die bestätigten Personen, Vortragsthemen und Abstracts werden Anfang 2027 hier veröffentlicht.
        </p>
      </div>
    </div>

    <!-- Beitragsformate -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white rounded-xl border border-slate-200 p-6 space-y-2">
        <h2 class="text-lg font-bold text-slate-900">Keynote-Vorträge</h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          Eingeladene Forschende aus Universität und Industrie geben Einblicke in aktuelle Entwicklungen und Grundlagen der Computerlinguistik und Sprachtechnologie.
        </p>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 p-6 space-y-2">
        <h2 class="text-lg font-bold text-slate-900">Studentische Vorträge und Poster</h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          Fachvorträge und Poster von Studierenden im Bachelor, Master oder Promotionsstudium zu Seminararbeiten, Abschlussarbeiten und praktischen Projekten.
        </p>
      </div>
    </section>

    <!-- Call for Papers Information -->
    <section class="bg-white rounded-xl border border-slate-200 p-8 text-center space-y-3">
      <h2 class="text-xl font-bold text-slate-900">Call for Papers</h2>
      <p class="text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
        Die Einreichung für Vorträge und Poster öffnet Anfang 2027. Genaue Vorgaben, Formate und Fristen werden rechtzeitig hier und über unsere Social-Media-Kanäle bekanntgegeben.
      </p>
      <div class="pt-3 flex flex-wrap justify-center gap-3">
        <a
          href="https://www.instagram.com/tacosconference/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition"
        >
          <span>Instagram: @tacosconference</span>
        </a>
        <a
          href="https://www.linkedin.com/company/tacosconference/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition"
        >
          <span>LinkedIn: tacosconference</span>
        </a>
      </div>
    </section>

  </div>
</Layout>
