---
import Layout from '../../layout/layout-de.astro'

const base = "/TaCoS-Trier";

const placeholderSpeakers = [
  {
    name: "Keynote Referent*in I",
    role: "Professur für Digital Humanities & NLP",
    institution: "Universität Trier",
    topic: "Sprachmodelle & Historische Korpora",
    image: `${base}/images/PB.png`,
    status: "Wird angekündigt",
  },
  {
    name: "Keynote Referent*in II",
    role: "Senior NLP Research Scientist",
    institution: "Industrie / Forschungsinstitut",
    topic: "Spracherkennung & Multimodale KI",
    image: `${base}/images/PB.png`,
    status: "Wird angekündigt",
  },
  {
    name: "Keynote Referent*in III",
    role: "Computerlinguist*in & Dozent*in",
    institution: "Partneruniversität",
    topic: "Low-Resource Sprachen & Syntax",
    image: `${base}/images/PB.png`,
    status: "Wird angekündigt",
  },
];
---

<Layout
  title="Referent*innen | 36. TaCoS Trier 2027"
  description="Erfahre mehr über die Keynote-Speaker und Gastvortragenden der 36. TaCoS an der Universität Trier."
>
  <div class="space-y-16 py-4">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 text-red-800 text-xs font-semibold tracking-wide border border-red-200">
        Wissenschaftliches Programm
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Keynote Referent*innen
      </h1>
      <p class="text-slate-600 text-base sm:text-lg">
        Wir laden renommierte Wissenschaftler*innen und Praktiker*innen aus Computerlinguistik und Sprachtechnologie für Hauptvorträge nach Trier ein.
      </p>
    </div>

    <!-- Announcement Alert -->
    <div class="max-w-2xl mx-auto bg-amber-50/70 border border-amber-200 rounded-2xl p-4 text-center">
      <p class="text-xs sm:text-sm font-medium text-amber-900">
        📢 Die Abstimmungen mit den Keynote-Gästen laufen derzeit. Das vollständige Programm und die Vortragstitel werden hier in Kürze bekanntgegeben.
      </p>
    </div>

    <!-- Speakers Grid -->
    <section class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {placeholderSpeakers.map((speaker) => (
          <div class="bg-white rounded-2xl p-6 shadow-xs border border-slate-200 hover:shadow-md hover:border-red-200 transition-all flex flex-col items-center text-center">
            <div class="relative mb-5">
              <img
                src={speaker.image}
                alt={speaker.name}
                class="w-32 h-32 rounded-full object-cover ring-4 ring-slate-100 shadow-xs"
              />
              <span class="absolute bottom-1 right-1 bg-slate-800 text-white text-[10px] font-semibold px-2 py-0.5 rounded-full">
                Keynote
              </span>
            </div>
            
            <h3 class="text-lg font-bold text-slate-900">{speaker.name}</h3>
            <p class="text-xs font-semibold text-red-700 mt-0.5">{speaker.role}</p>
            <p class="text-xs text-slate-500 mt-1">{speaker.institution}</p>
            
            <div class="mt-4 pt-4 border-t border-slate-100 w-full text-left">
              <span class="text-[11px] uppercase tracking-wider font-semibold text-slate-400 block mb-1">
                Themenschwerpunkt
              </span>
              <p class="text-xs text-slate-600 italic">
                "{speaker.topic}"
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Call for Student Presentations -->
    <section class="max-w-3xl mx-auto bg-white rounded-2xl p-8 border border-slate-200 shadow-xs text-center space-y-4">
      <span class="text-xs font-bold uppercase tracking-wider text-red-700">Eigene Beiträge</span>
      <h3 class="text-2xl font-bold text-slate-900">Halte einen eigenen Vortrag!</h3>
      <p class="text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
        Die TaCoS lebt von studentischen Beiträgen. Ob Bachelor- oder Masterarbeit, Seminararbeit oder spannendes Softwareprojekt: Jede*r ist herzlich eingeladen, einen Vortrag oder Workshop einzureichen.
      </p>
      <div class="pt-2">
        <a
          href="mailto:tacos@uni-trier.de"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-red-700 text-white font-semibold text-sm hover:bg-red-800 transition"
        >
          <span>Vortrag / Abstract vorschlagen</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </section>

  </div>
</Layout>
