---
import Layout from '../../layout/layout-de.astro';

const base = "/TaCoS-Trier";

const links = [
  {
    href: `${base}/de/schedule`,
    title: "Programm",
    desc: "Zeitplan für Vorträge, Workshops und Abendessen.",
  },
  {
    href: `${base}/de/speakers`,
    title: "Keynotes",
    desc: "Eingeladene Referierende aus Wissenschaft und Praxis.",
  },
  {
    href: `${base}/de/registration`,
    title: "Anmeldung",
    desc: "Informationen zur Teilnahme und Tagungsanmeldung.",
  },
  {
    href: `${base}/de/sponsors`,
    title: "Sponsoren",
    desc: "Informationen für Partner und Förderer der Tagung.",
  },
  {
    href: `${base}/de/map`,
    title: "Campusplan",
    desc: "Wegbeschreibung und Raumübersicht auf Campus I.",
  },
  {
    href: `${base}/de/team`,
    title: "Team",
    desc: "Das studentische Organisationsteam der TaCoS 2027 in Trier.",
  },
];
---

<Layout
  title="36. TaCoS Trier 2027 | Tagung der Computerlinguistik-Studierenden"
  description="TaCoS 2027 an der Universität Trier vom 03. bis 05. Juni 2027. Die jährliche Fachtagung von und für Studierende."
  fullWidth={true}
>
  <!-- Hero Section mit Campus-Hintergrund -->
  <section class="relative min-h-[75vh] flex items-center justify-center bg-slate-900 text-white overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${base}/images/Campus_Oben.jpg');`}
      aria-hidden="true"
    ></div>

    <!-- Ruhiger dunkler Filter für klare Lesbarkeit -->
    <div class="absolute inset-0 bg-slate-950/65"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 py-20 text-center flex flex-col items-center">
      <p class="text-xs sm:text-sm font-semibold text-slate-300 uppercase tracking-widest mb-3">
        36. Tagung der Computerlinguistik-Studierenden
      </p>

      <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold text-white tracking-tight leading-tight mb-3">
        TaCoS 2027
      </h1>

      <p class="text-xl sm:text-2xl text-slate-200 font-light mb-1">
        03. bis 05. Juni 2027
      </p>

      <p class="text-base sm:text-lg text-slate-300 font-normal mb-8">
        Universität Trier
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href={`${base}/de/registration`}
          class="px-6 py-3 rounded-lg bg-red-700 text-white font-medium text-sm hover:bg-red-600 transition-colors"
        >
          Teilnahme
        </a>
        <a
          href={`${base}/de/schedule`}
          class="px-6 py-3 rounded-lg bg-white/10 border border-white/20 text-white font-medium text-sm hover:bg-white/20 transition-colors"
        >
          Programm ansehen
        </a>
      </div>
    </div>
  </section>

  <!-- Countdown Section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 -mt-10 relative z-20">
    <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xl shadow-slate-200/50 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="text-center sm:text-left">
        <span class="inline-block text-xs font-bold uppercase tracking-wider text-red-700 mb-1">
          Countdown zur Tagung
        </span>
        <h2 class="text-base sm:text-lg font-bold text-slate-900 leading-tight">
          TaCoS 2027 in Trier
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Beginn am 03. Juni 2027 um 08:00 Uhr MESZ
        </p>
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <div class="flex flex-col items-center">
          <div class="w-14 sm:w-16 h-14 sm:h-16 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-xs">
            <span class="countdown-days text-xl sm:text-2xl font-bold font-mono tabular-nums leading-none">--</span>
          </div>
          <span class="text-[10px] sm:text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1.5">Tage</span>
        </div>

        <span class="text-slate-400 font-bold text-lg mb-4">:</span>

        <div class="flex flex-col items-center">
          <div class="w-14 sm:w-16 h-14 sm:h-16 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-xs">
            <span class="countdown-hours text-xl sm:text-2xl font-bold font-mono tabular-nums leading-none">--</span>
          </div>
          <span class="text-[10px] sm:text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1.5">Std</span>
        </div>

        <span class="text-slate-400 font-bold text-lg mb-4">:</span>

        <div class="flex flex-col items-center">
          <div class="w-14 sm:w-16 h-14 sm:h-16 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-xs">
            <span class="countdown-minutes text-xl sm:text-2xl font-bold font-mono tabular-nums leading-none">--</span>
          </div>
          <span class="text-[10px] sm:text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1.5">Min</span>
        </div>

        <span class="text-slate-400 font-bold text-lg mb-4">:</span>

        <div class="flex flex-col items-center">
          <div class="w-14 sm:w-16 h-14 sm:h-16 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-xs">
            <span class="countdown-seconds text-xl sm:text-2xl font-bold font-mono tabular-nums leading-none text-red-400">--</span>
          </div>
          <span class="text-[10px] sm:text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1.5">Sek</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Über die TaCoS -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      
      <!-- Linke Spalte: Willkommen und Links -->
      <div class="space-y-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight mb-3">
            Wir freuen uns auf euch
          </h2>
          <p class="text-slate-600 leading-relaxed">
            Die Fachschaft CoDiPho (Computerlinguistik, Digital Humanities und Phonetik) und das Organisationsteam der Universität Trier richten die 36. TaCoS im Juni 2027 aus. Egal ob ihr eigene Arbeiten oder Abschlussarbeiten vorstellen wollt, Vorträge hören möchtet oder andere Studierende aus der Computerlinguistik, dem NLP und angrenzenden Fächern kennenlernen wollt: alle sind willkommen.
          </p>
        </div>

        <div class="space-y-3 pt-2">
          <a
            href="https://www.uni-trier.de/"
            target="_blank"
            rel="noopener noreferrer"
            class="block p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition-colors"
          >
            <div class="text-sm font-semibold text-slate-900">Universität Trier</div>
            <div class="text-xs text-slate-500 mt-0.5">Mehr über die Universität erfahren &rarr;</div>
          </a>

          <a
            href="https://linguistik.computer/"
            target="_blank"
            rel="noopener noreferrer"
            class="block p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition-colors"
          >
            <div class="text-sm font-semibold text-slate-900">Frühere TaCoS-Ausgaben</div>
            <div class="text-xs text-slate-500 mt-0.5">Archiv früherer Tagungen auf linguistik.computer &rarr;</div>
          </a>
        </div>
      </div>

      <!-- Rechte Spalte: Was ist die TaCoS? -->
      <div class="bg-white rounded-xl p-6 sm:p-8 border border-slate-200 space-y-4">
        <h3 class="text-xl font-bold text-slate-900">
          Was ist die TaCoS?
        </h3>
        <p class="text-slate-600 text-sm leading-relaxed">
          Die „Tagung der Computerlinguistik-Studierenden“ (TaCoS) ist eine von Studierenden geleitete Fachtagung für Computerlinguistik. Sie wurde erstmals 1992 organisiert und findet einmal jährlich statt. Sie bietet Studierenden der Computerlinguistik, des NLP und angrenzender Fachbereiche die Gelegenheit, sich in Vorträgen und Workshops fachlich auszutauschen. Die Tagung wird von Teams studentischer Freiwilliger an ihrer Universität ausgerichtet.
        </p>
        <p class="text-slate-600 text-sm leading-relaxed">
          Im Mittelpunkt der Tagung stehen studentische Vorträge, Workshops und Postersessions. Zudem halten eingeladene Referierende aus Wissenschaft und Praxis Keynote-Vorträge. Ein begleitendes Rahmenprogramm bietet Raum für Austausch und Vernetzung.
        </p>
      </div>

    </div>
  </section>

  <!-- Programmübersicht (Invertierte dunkle Fläche) -->
  <section class="bg-slate-900 text-white py-16 sm:py-20 border-y border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="mb-10 text-center sm:text-left">
        <span class="text-xs font-mono uppercase tracking-widest text-red-400 block mb-1">Programm</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Programm (Im Aufbau)</h2>
        <p class="text-slate-400 text-sm mt-1">Vortragstitel und genaue Uhrzeiten folgen nach Abschluss des Call for Papers.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Tag 1 -->
        <div class="p-6 rounded-xl border border-slate-800 bg-slate-950/70">
          <div class="text-xs font-mono uppercase tracking-wider text-red-400 mb-1">Donnerstag, 03. Juni</div>
          <h3 class="text-base font-bold text-white mb-3">Anreise und Auftakt</h3>
          <ul class="text-sm text-slate-300 space-y-2">
            <li>Anreise und Check-in</li>
            <li>Begrüßung</li>
            <li>Eröffnungs-Keynote</li>
            <li>Kennenlernen am Abend</li>
          </ul>
        </div>

        <!-- Tag 2 -->
        <div class="p-6 rounded-xl border border-slate-800 bg-slate-950/70">
          <div class="text-xs font-mono uppercase tracking-wider text-red-400 mb-1">Freitag, 04. Juni</div>
          <h3 class="text-base font-bold text-white mb-3">Vorträge und Poster</h3>
          <ul class="text-sm text-slate-300 space-y-2">
            <li>Keynote-Vortrag</li>
            <li>Studentische Vortragsblöcke</li>
            <li>Postersession</li>
            <li>Konferenzabend</li>
          </ul>
        </div>

        <!-- Tag 3 -->
        <div class="p-6 rounded-xl border border-slate-800 bg-slate-950/70">
          <div class="text-xs font-mono uppercase tracking-wider text-red-400 mb-1">Samstag, 05. Juni</div>
          <h3 class="text-base font-bold text-white mb-3">Workshops und Abschluss</h3>
          <ul class="text-sm text-slate-300 space-y-2">
            <li>Praktische Workshops</li>
            <li>Gemeinsamer Austausch</li>
            <li>Abschlussplenum und Feedback</li>
            <li>Verabschiedung und Abreise</li>
          </ul>
        </div>
      </div>

      <div class="mt-8 text-center sm:text-left">
        <a
          href={`${base}/de/schedule`}
          class="text-sm font-semibold text-red-400 hover:text-red-300 transition-colors"
        >
          Zum Programm &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Veranstaltungsort -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      
      <div class="space-y-5">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight mb-3">
            Der Veranstaltungsort
          </h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            Die TaCoS 2027 findet auf dem Campus I der Universität Trier statt. Alle Vorträge, Workshops und das Catering finden in den zentralen Hörsaalgebäuden auf dem Tarforst-Campus statt.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-slate-200 bg-white">
          <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Adresse</div>
          <address class="text-sm font-medium not-italic text-slate-900 leading-snug">
            Universität Trier<br />
            Campus I, Universitätsring 15<br />
            54296 Trier, Deutschland
          </address>
        </div>

        <div class="flex items-center gap-4 text-sm font-medium">
          <a
            href={`${base}/de/map`}
            class="text-red-700 hover:text-red-800 transition-colors"
          >
            Campusplan und Anreise &rarr;
          </a>
        </div>
      </div>

      <!-- 2 Fotos ohne künstliche Überlagerungen -->
      <div class="grid grid-cols-2 gap-4">
        <img
          src={`${base}/images/Campus_Bibliothek.jpg`}
          alt="Universitätsbibliothek Trier"
          class="w-full h-48 sm:h-56 object-cover rounded-xl border border-slate-200"
        />
        <img
          src={`${base}/images/Gebaude.jpg`}
          alt="Architektur auf dem Campus der Universität Trier"
          class="w-full h-48 sm:h-56 object-cover object-top rounded-xl border border-slate-200"
        />
      </div>

    </div>
  </section>

  <!-- Tagungsstadt Trier -->
  <section class="border-t border-slate-200 bg-slate-50/70 py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        
        <!-- Foto der Porta Nigra -->
        <div class="order-2 lg:order-1">
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
            <img
              src={`${base}/images/porta_nigra.JPG`}
              alt="Porta Nigra römisches Stadttor in Trier"
              class="w-full h-72 sm:h-96 object-cover object-center"
            />
            <div class="p-3 sm:p-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500">
              <span class="font-medium text-slate-700">Porta Nigra (ca. 170 n. Chr.)</span>
              <span>Foto: Roland Morgen</span>
            </div>
          </div>
        </div>

        <!-- Stadt-Informationen -->
        <div class="order-1 lg:order-2 space-y-4">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-red-700 block mb-1">Tagungsstadt</span>
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight mb-3">
              Älteste Stadt Deutschlands
            </h2>
            <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
              Im Jahr 16 v. Chr. als <em>Augusta Treverorum</em> gegründet, blickt Trier auf über 2.000 Jahre Geschichte zurück. An der Mosel gelegen, bietet die Stadt römische UNESCO-Welterbestätten wie Porta Nigra, die Kaiserthermen und das Amphitheater direkt im Stadtzentrum.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Informationsübersicht -->
  <section class="bg-white border-y border-slate-200 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="mb-8">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          Alle Bereiche im Überblick
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {links.map((item) => (
          <a
            href={item.href}
            class="block p-5 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white hover:border-slate-300 transition-colors"
          >
            <h3 class="font-bold text-slate-900 text-base mb-1">
              {item.title}
            </h3>
            <p class="text-sm text-slate-600">
              {item.desc}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Sponsoren -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 text-center">
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight mb-2">
      Sponsoren
    </h2>
    <p class="text-sm text-slate-600 max-w-lg mx-auto mb-8">
      Die TaCoS 2027 wird durch die Universität Trier, den Fachschaftsrat CoDiPho (Computerlinguistik, Digital Humanities und Phonetik) und unsere Förderer unterstützt.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4 py-4 max-w-3xl mx-auto">
      <div class="px-6 py-4 rounded-lg border border-slate-200 bg-white font-medium text-slate-800 text-sm">
        Universität Trier
      </div>
      <div class="px-6 py-4 rounded-lg border border-slate-200 bg-white font-medium text-slate-800 text-sm">
        FSR CoDiPho Trier
      </div>
      <a
        href={`${base}/de/sponsors`}
        class="px-5 py-3.5 rounded-lg border-2 border-dashed border-slate-300 bg-slate-50/50 hover:border-slate-400 font-mono text-xs uppercase tracking-wider text-slate-500 transition-colors"
      >
        + Ihr Logo hier
      </a>
      <a
        href={`${base}/de/sponsors`}
        class="px-5 py-3.5 rounded-lg border-2 border-dashed border-slate-300 bg-slate-50/50 hover:border-slate-400 font-mono text-xs uppercase tracking-wider text-slate-500 transition-colors"
      >
        + Ihr Logo hier
      </a>
    </div>

    <p class="text-xs text-slate-500 mt-6">
      Möchtet ihr die Tagung unterstützen? Mehr Informationen gibt es auf unserer <a href={`${base}/de/sponsors`} class="text-slate-800 underline">Sponsoring-Seite</a>.
    </p>
  </section>

</Layout>

<script>
  const dest = new Date("2027-06-03T08:00:00").getTime();

  const daysEl = document.querySelector(".countdown-days");
  const hoursEl = document.querySelector(".countdown-hours");
  const minsEl = document.querySelector(".countdown-minutes");
  const secsEl = document.querySelector(".countdown-seconds");

  function updateCountdown() {
    const now = new Date().getTime();
    const diff = dest - now;

    if (diff <= 0) {
      if (daysEl) daysEl.textContent = "00";
      if (hoursEl) hoursEl.textContent = "00";
      if (minsEl) minsEl.textContent = "00";
      if (secsEl) secsEl.textContent = "00";
      return;
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);

    if (daysEl) daysEl.textContent = String(days).padStart(2, "0");
    if (hoursEl) hoursEl.textContent = String(hours).padStart(2, "0");
    if (minsEl) minsEl.textContent = String(minutes).padStart(2, "0");
    if (secsEl) secsEl.textContent = String(seconds).padStart(2, "0");
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
