---
import Layout from '../layout/layout.astro';

const days = [
  {
    day: "Day 1",
    label: "Thursday, June 3",
    items: [
      {
        period: "Afternoon",
        title: "Arrival and Check-in",
        desc: "Registration desk open at Campus I. Badges and conference materials pickup.",
      },
      {
        period: "Late Afternoon",
        title: "Opening and Keynote Lecture",
        desc: "Welcome remarks by the student organizers followed by the opening keynote.",
      },
      {
        period: "Evening",
        title: "Welcome Get-Together",
        desc: "Informal dinner and social evening to meet participants.",
      },
    ],
  },
  {
    day: "Day 2",
    label: "Friday, June 4",
    items: [
      {
        period: "Morning",
        title: "Keynote Lecture and Student Talks",
        desc: "Morning keynote followed by the first block of student presentations.",
      },
      {
        period: "Midday",
        title: "Lunch Break",
        desc: "Lunch at the university cafeteria.",
      },
      {
        period: "Afternoon",
        title: "Poster Session and Student Presentations",
        desc: "Student research presentations and interactive poster discussions.",
      },
      {
        period: "Evening",
        title: "Conference Dinner and City Walk",
        desc: "Dinner and social program in historic Trier.",
      },
    ],
  },
  {
    day: "Day 3",
    label: "Saturday, June 5",
    items: [
      {
        period: "Morning",
        title: "Workshops and Final Talks",
        desc: "Practical workshops, tutorials, and final student talks.",
      },
      {
        period: "Midday",
        title: "Closing Session and Discussion",
        desc: "Joint plenary session, feedback, and concluding remarks for the conference.",
      },
      {
        period: "Afternoon",
        title: "Farewell and Departure",
        desc: "Closing remarks, luggage collection, and departure.",
      },
    ],
  },
];

const gcalUrl = "https://calendar.google.com/calendar/render?action=TEMPLATE&text=36.+TaCoS+Trier+2027&dates=20270603T080000Z/20270605T140000Z&details=36th+Student+Conference+for+Computational+Linguistics+at+Trier+University.&location=Trier+University,+Campus+I";
---

<Layout
  title="Schedule | 36. TaCoS Trier 2027"
  description="Schedule for the 36th TaCoS at Trier University."
>
  <div class="space-y-12 py-4">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 tracking-tight">
        Schedule
      </h1>
      <p class="text-slate-600 text-base sm:text-lg">
        Schedule overview for TaCoS 2027 at Trier University (Campus I).
      </p>

      <!-- Calendar Sync Actions -->
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
        <a
          href={gcalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white text-slate-700 hover:text-red-700 border border-slate-200 text-xs sm:text-sm font-semibold shadow-xs hover:bg-slate-50 transition"
        >
          <svg class="h-4 w-4 text-red-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Save dates to Google Calendar</span>
        </a>

        <button
          id="btn-download-ics"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white text-slate-700 hover:text-red-700 border border-slate-200 text-xs sm:text-sm font-semibold shadow-xs hover:bg-slate-50 transition cursor-pointer"
        >
          <svg class="h-4 w-4 text-red-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Download .ics file</span>
        </button>
      </div>
    </div>

    <!-- Status Banner: Under Development -->
    <div class="max-w-4xl mx-auto bg-amber-50/80 border border-amber-200 rounded-xl p-5 text-center sm:text-left flex flex-col sm:flex-row items-center sm:items-start gap-4">
      <div class="h-9 w-9 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center shrink-0 font-bold text-sm">
        i
      </div>
      <div class="space-y-1">
        <h2 class="text-sm font-bold text-amber-950">Detailed Schedule in Preparation</h2>
        <p class="text-xs sm:text-sm text-amber-900 leading-relaxed">
          The exact timetable, talk titles, and speaker slots are not set yet. Presentation times will be published after the Call for Papers concludes in early 2027.
        </p>
      </div>
    </div>

    <!-- Three-Day Schedule Grid -->
    <section class="max-w-4xl mx-auto space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {days.map((d) => (
          <div class="bg-white rounded-xl border border-slate-200 p-6 flex flex-col justify-between">
            <div>
              <span class="text-xs font-mono uppercase tracking-wider text-red-700 block mb-1">
                {d.day}
              </span>
              <h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3 mb-4">
                {d.label}
              </h2>
              
              <div class="space-y-4">
                {d.items.map((it) => (
                  <div class="space-y-0.5">
                    <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400 block">
                      {it.period}
                    </span>
                    <h3 class="text-sm font-bold text-slate-900">
                      {it.title}
                    </h3>
                    <p class="text-xs text-slate-600 leading-relaxed">
                      {it.desc}
                    </p>
                  </div>
                ))}
              </div>
            </div>

            <div class="mt-6 pt-3 border-t border-slate-100 text-[11px] text-slate-400">
              Campus I, Trier University
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Call for Participation Note -->
    <section class="max-w-4xl mx-auto bg-slate-50 rounded-xl border border-slate-200 p-6 text-center space-y-2">
      <h2 class="text-base font-bold text-slate-900">Call for Presentations and Posters</h2>
      <p class="text-xs sm:text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
        Students at all levels (Bachelor, Master, PhD) will be invited to submit abstracts for talks or poster presentations. Submission guidelines and deadlines will be announced here.
      </p>
    </section>

  </div>
</Layout>

<script>
  const btnIcs = document.getElementById("btn-download-ics");
  if (btnIcs) {
    btnIcs.addEventListener("click", () => {
      const icsData = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//TaCoS 2027//Trier University//EN",
        "BEGIN:VEVENT",
        "UID:tacos2027-trier-dates@linguistik.computer",
        "DTSTAMP:20261025T000000Z",
        "DTSTART:20270603T080000Z",
        "DTEND:20270605T140000Z",
        "SUMMARY:36. TaCoS Trier 2027",
        "DESCRIPTION:36th Student Conference for Computational Linguistics at Trier University.",
        "LOCATION:Trier University Campus I, Universitätsring 15, 54296 Trier, Germany",
        "END:VEVENT",
        "END:VCALENDAR"
      ].join("\r\n");

      const blob = new Blob([icsData], { type: "text/calendar;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", "tacos-2027-trier.ics");
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });
  }
</script>
