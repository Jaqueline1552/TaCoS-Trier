---
import Layout from '../layout/layout.astro'

const base = "/TaCoS-Trier";
---

<Layout
  title="Contact Us | 36. TaCoS Trier 2027"
  description="Contact the organizing committee of the 36th TaCoS Conference at Trier University."
>
  <div class="space-y-16 py-4">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 text-red-800 text-xs font-semibold tracking-wide border border-red-200">
        Get In Touch
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Contact the Organizers
      </h1>
      <p class="text-slate-600 text-base sm:text-lg">
        Have questions regarding paper submissions, travel, registration, sponsorship, or volunteering? We are here to help!
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      
      <!-- Email Card -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-xs border border-slate-200 hover:shadow-md hover:border-red-200 transition-all text-center flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-xl bg-red-50 text-red-700 flex items-center justify-center mx-auto">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900">Email Us</h3>
          <p class="text-xs text-slate-500">For all general inquiries, questions, and submissions.</p>
        </div>
        <div class="pt-6">
          <a
            href="mailto:tacos@uni-trier.de"
            class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 px-4 rounded-xl bg-red-700 text-white font-semibold text-xs sm:text-sm hover:bg-red-800 transition"
          >
            <span>tacos@uni-trier.de</span>
          </a>
        </div>
      </div>

      <!-- Social Channels -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-xs border border-slate-200 hover:shadow-md hover:border-red-200 transition-all text-center flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-xl bg-red-50 text-red-700 flex items-center justify-center mx-auto">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900">Social Media</h3>
          <p class="text-xs text-slate-500">Follow conference updates, deadlines, and highlights.</p>
        </div>
        <div class="pt-6 space-y-2">
          <a
            href="https://www.instagram.com/tacosconference/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 w-full py-2 px-3 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition"
          >
            <span>Instagram: @tacosconference</span>
          </a>
          <a
            href="https://www.linkedin.com/company/tacosconference/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 w-full py-2 px-3 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition"
          >
            <span>LinkedIn: tacosconference</span>
          </a>
        </div>
      </div>

      <!-- Host Location -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-xs border border-slate-200 hover:shadow-md hover:border-red-200 transition-all text-center flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-xl bg-red-50 text-red-700 flex items-center justify-center mx-auto">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900">Host Venue</h3>
          <p class="text-xs text-slate-500">Trier University (Campus II)</p>
        </div>
        <div class="pt-6 text-xs text-slate-600 space-y-1">
          <p class="font-medium text-slate-900">Universität Trier</p>
          <p>Universitätsring 15</p>
          <p>54296 Trier, Germany</p>
        </div>
      </div>

    </div>

  </div>
</Layout>
