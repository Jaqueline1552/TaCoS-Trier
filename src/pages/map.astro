---
import Layout from '../layout/layout.astro'

const campusMapUrl = "https://www.uni-trier.de/fileadmin/organisation/Presse/Lageplaene/Lageplan202408_CampusI.svg";
---

<Layout
  title="Campus Map | 36. TaCoS Trier 2027"
  description="Campus overview, interactive map, and transit directions for the 36th TaCoS at Trier University."
>
  <div class="space-y-12 py-4 max-w-5xl mx-auto">

    <!-- Header -->
    <div class="text-center space-y-3">
      <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 tracking-tight">
        Campus Map
      </h1>
      <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto">
        TaCoS 2027 takes place at <strong>Campus I of Trier University</strong> (Universitätsring 15, 54296 Trier).
      </p>
    </div>

    <!-- Public Transit Section -->
    <section class="bg-white rounded-xl border border-slate-200 p-6 sm:p-8">
      <h2 class="text-lg font-bold text-slate-900 mb-1">Getting to Campus I</h2>
      <p class="text-xs text-slate-500 mb-6">Public transit connections from Trier Hauptbahnhof and the city center</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm">
        <div class="space-y-2">
          <h3 class="font-bold text-slate-900">By Train</h3>
          <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">
            Arrive at Trier Hauptbahnhof (Main Station). Regional trains offer direct connections to Luxembourg, Koblenz, Saarbrücken, and Mannheim.
          </p>
          <div class="text-xs text-slate-500">Destination: Trier Hbf</div>
        </div>

        <div class="space-y-2">
          <h3 class="font-bold text-slate-900">By City Bus</h3>
          <ul class="text-xs sm:text-sm text-slate-600 space-y-1">
            <li><strong>From Hauptbahnhof (Hbf):</strong> Lines <strong>3</strong> and <strong>13</strong></li>
            <li><strong>From Porta Nigra:</strong> Lines <strong>4</strong> and <strong>14</strong></li>
          </ul>
          <p class="text-xs text-slate-500 pt-1">
            All lines stop directly at <em>"Universität"</em> (approx. 15–20 minutes travel time).
          </p>
        </div>
      </div>
    </section>

    <!-- Interactive Map Embed -->
    <section class="bg-white rounded-xl border border-slate-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-base font-bold text-slate-900">Interactive Map</h2>
          <p class="text-xs text-slate-500">Campus I and surrounding area</p>
        </div>
        <a
          href="https://www.openstreetmap.org/?mlat=49.7460&mlon=6.6865#map=16/49.7460/6.6865"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold text-slate-700 hover:text-red-700 inline-flex items-center gap-1 transition"
        >
          <span>Open full map in OpenStreetMap</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <div class="w-full h-80 sm:h-96 relative bg-slate-100">
        <iframe
          title="Trier University Campus I Map"
          width="100%"
          height="100%"
          class="border-0 w-full h-full"
          loading="lazy"
          src="https://www.openstreetmap.org/export/embed.html?bbox=6.6660%2C49.7360%2C6.7060%2C49.7560&amp;layer=mapnik&amp;marker=49.7460%2C6.6865"
        ></iframe>
      </div>

      <div class="px-6 py-3 bg-slate-50/50 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500">
        <span>Address: Campus I, Universitätsring 15, 54296 Trier</span>
        <span>Coordinates: 49.7460° N, 6.6865° E</span>
      </div>
    </section>

    <!-- Campus I Site Plan -->
    <section class="bg-white rounded-xl border border-slate-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-base font-bold text-slate-900">Campus I Site Plan</h2>
          <p class="text-xs text-slate-500">Official site plan provided by Trier University Administration</p>
        </div>
        <a
          href={campusMapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold text-slate-700 hover:text-red-700 inline-flex items-center gap-1 transition"
        >
          <span>Open Vector Map (SVG)</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <div class="p-6 bg-slate-50/50 flex items-center justify-center">
        <img
          src={campusMapUrl}
          alt="Trier University Campus I Site Plan"
          class="max-h-[520px] w-auto object-contain rounded-lg"
          loading="lazy"
        />
      </div>
    </section>

  </div>
</Layout>
